          <div class="field" style="flex:1;">
            <label>小節標題</label>
            <input type="text" id="fSecTitle" value="${escapeAttr(s.title)}" />
          </div>
        </div>
      </div>
      <div class="editor-card">
        <h2>內容區塊</h2>
        <div class="sub">共 ${s.blocks.length} 個區塊</div>
        <div class="block-list" id="blockList"></div>
        <div class="add-block">
          <div class="add-block-title">＋ 新增內容塊</div>
          <div class="add-block-types">
            <button data-type="markdown">📝 Markdown 文字</button>
            <button data-type="image">🖼 圖片</button>
            <button data-type="youtube">▶ YouTube 影片</button>
            <button data-type="objectives">◎ 學習目標</button>
            <button data-type="keyideas">✦ Key points</button>
            <button data-type="formula">∑ 數學公式 (LaTeX)</button>
            <button data-type="answer">✓ 答案（可展開）</button>
            <button data-type="point">💡 重點框 (Point)</button>
            <button data-type="think">🤔 想一想 (Think)</button>
            <button data-type="caution">⚠ 注意 (Caution)</button>
            <button data-type="question">❓ 題目 (Question)</button>
            <button data-type="answerlines">⫶ 作答橫線</button>
            <button data-type="pagebreak">⏎ 換頁</button>
            <button data-type="spacer">↕ 空白行</button>
            <button data-type="mc">✓ 選擇題 (MC)</button>
            <button data-type="table">⊞ 表格</button>
          </div>
        </div>
      </div>
    `;
    document.getElementById('fSecNum').oninput = e => { s.number = e.target.value; renderOutline(); renderPreview(); };
    document.getElementById('fSecTitle').oninput = e => { s.title = e.target.value; renderOutline(); renderPreview(); };
    const list = document.getElementById('blockList');
    if (s.blocks.length === 0) {
      list.innerHTML = '<div class="empty"><p>尚無內容塊，從下方選一個加入</p></div>';
    } else {
      list.innerHTML = s.blocks.map(b => `
        <div class="block-item" data-bid="${b.id}">
          <div class="oi-icon block ${b.type}">${BLOCK_ICONS[b.type]}</div>
          <div style="flex:1; min-width:0;">
            <div style="font-weight:500; font-size:13.5px;">${escapeHtml(BLOCK_LABELS[b.type] || b.type)}</div>
            <div style="color:#8e8e93; font-size:11.5px; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escapeHtml(getBlockPreview(b))}</div>
          </div>
        </div>
      `).join('');
      list.querySelectorAll('.block-item').forEach(el => {
        el.onclick = () => {
          state.selection = { kind: 'block', chapterId: c.id, sectionId: s.id, blockId: el.dataset.bid };
          renderEditor();
        };
      });
    }
    document.querySelectorAll('.add-block-types button').forEach(btn => {
      btn.onclick = () => addBlock(c.id, s.id, btn.dataset.type);
    });
    return;
  }

  if (sel.kind === 'block') {
    const b = findBlock(sel.chapterId, sel.sectionId, sel.blockId);
    if (!b) { state.selection = { kind: 'section', chapterId: sel.chapterId, sectionId: sel.sectionId }; renderEditor(); return; }
    const canSide = SIDE_BLOCK_TYPES.has(b.type);
    const col = b.column || 'main';
    root.innerHTML = `
      <div class="editor-card">
        <h2><span class="oi-icon block ${b.type}" style="width:30px; height:30px; font-size:14px;">${BLOCK_ICONS[b.type]}</span> ${escapeHtml(BLOCK_LABELS[b.type] || b.type)} <span class="preview-pill">${b.type}</span></h2>
        <div class="sub">編輯下方欄位，右側 A4 預覽即時更新</div>
        ${canSide ? `
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
            <span style="font-size:11px; font-weight:600; color:#8e8e93; text-transform:uppercase; letter-spacing:0.5px;">位置</span>
            <div class="col-toggle" id="colToggle">
              <button data-col="main" class="${col === 'main' ? 'active' : ''}">主欄 (右)</button>
              <button data-col="side" class="${col === 'side' ? 'active' : ''}">側欄 (左)</button>
            </div>
            <span style="font-size:11.5px; color:#8e8e93;">側欄較窄，適合小提醒框</span>
          </div>
        ` : ''}
        ${renderBlockEditor(b)}
      </div>
    `;
    bindBlockEditor(b);
    if (canSide) {
      const toggle = document.getElementById('colToggle');
      toggle.querySelectorAll('button').forEach(btn => {
        btn.onclick = () => {
          b.column = btn.dataset.col;
          renderEditor();
          renderPreview();
        };
      });
    }
  }
}

function renderBlockEditor(b) {
  if (b.type === 'markdown') {
    return `
      <div class="field">
        <label>Markdown 內容</label>
        <textarea id="bContent" class="mono" rows="10" placeholder="支援 **粗體** *斜體* # 標題 - 列表 > 引用 \`code\`">${escapeHtml(b.content)}</textarea>
        <div style="margin-top:6px; font-size:11.5px; color:#8e8e93;">支援 GFM 語法。換行會自動轉成 &lt;br&gt;。</div>
      </div>
    `;
  }
  if (b.type === 'image') {
    return `
      <div class="field">
        <label>圖片來源（貼網址 或 上傳到 ImgBB）</label>
        <div style="display:flex; gap:6px;">
          <input type="text" id="bUrl" value="${escapeAttr(b.url)}" placeholder="https://..." style="flex:1;" />
          <button id="bUploadBtn" type="button" style="flex-shrink:0; padding:9px 14px; border-radius:8px; border:1px solid rgba(0,122,255,0.3); background:rgba(0,122,255,0.08); color:#007aff; font-size:13px; font-weight:500; cursor:pointer; white-space:nowrap;">📤 上傳圖片</button>
        </div>
        <input type="file" id="bFileInput" accept="image/*" style="display:none;" />
        <div id="bUploadStatus" style="margin-top:6px; font-size:11.5px; color:#8e8e93; min-height:14px;"></div>
        ${b.url ? `<div style="margin-top:6px;"><img src="${escapeAttr(b.url)}" style="max-width:100%; max-height:120px; border-radius:6px; border:1px solid rgba(60,60,67,0.1);" onerror="this.style.display='none';" /></div>` : ''}
      </div>
      <div class="field">
        <label>圖片說明（顯示在圖下方）</label>
        <input type="text" id="bCaption" value="${escapeAttr(b.caption || '')}" placeholder="圖 1-1 國際單位制..." />
      </div>
      <div class="field">
        <label>圖片大小（佔欄寬比例）</label>
        <div id="bImgSizeBtns" style="display:flex; gap:6px;">
          ${[125, 100, 75, 50].map(v => `
            <button type="button" data-size="${v}" style="flex:1; padding:8px 4px; border-radius:8px; border:1px solid ${(parseInt(b.width,10) || 100) === v ? '#007aff' : 'rgba(60,60,67,0.15)'}; background:${(parseInt(b.width,10) || 100) === v ? 'rgba(0,122,255,0.12)' : 'white'}; color:#1c1c1e; font-size:13px; font-weight:${(parseInt(b.width,10) || 100) === v ? '600' : '500'}; cursor:pointer;">${v}%</button>
          `).join('')}
        </div>
      </div>
      <div class="field">
        <label>圖片對齊</label>
        <div id="bImgAlignBtns" style="display:flex; gap:6px;">
          ${(() => {
            const cur = ['left','center','right'].includes(b.align) ? b.align : 'center';
            const ico = { left: '⇤', center: '↔', right: '⇥' };
            const tip = { left: '靠左對齊', center: '置中對齊', right: '靠右對齊' };
            return ['left','center','right'].map(a => `
              <button type="button" data-align="${a}" title="${tip[a]}" style="flex:1; padding:8px 4px; border-radius:8px; border:1px solid ${cur === a ? '#007aff' : 'rgba(60,60,67,0.15)'}; background:${cur === a ? 'rgba(0,122,255,0.12)' : 'white'}; color:#1c1c1e; font-size:15px; font-weight:${cur === a ? '600' : '500'}; cursor:pointer;">${ico[a]}</button>
            `).join('');
          })()}
        </div>
      </div>
    `;
  }
  if (b.type === 'youtube') {
    return `
      <div class="field">
        <label>YouTube Video ID（網址中 v= 後面的字串）</label>
        <input type="text" id="bVid" class="mono" value="${escapeAttr(b.videoId)}" placeholder="例如：dQw4w9WgXcQ" />
      </div>
      <div class="field">
        <label>影片說明</label>
        <input type="text" id="bCaption" value="${escapeAttr(b.caption || '')}" placeholder="物理學簡介..." />
      </div>
      <div style="font-size:12px; color:#8e8e93; padding:10px 12px; background:#f5f5f7; border-radius:8px; margin-top:6px;">
        💡 預覽中顯示 capsule：左邊 ▶ 紅色 play icon，右邊 QR code。學生用手機掃碼即可觀看。
      </div>
    `;
  }
  if (b.type === 'answer') {
    return `
      <div class="field">
        <label>答案標籤（顯示在小圓圈旁的提示文字）</label>
        <input type="text" id="bLabel" value="${escapeAttr(b.label || '答案')}" placeholder="答案" />
      </div>
      <div class="field">
        <label>答案內容（支援 Markdown 與 LaTeX 公式，$$...$$ 區塊、$...$ 行內）</label>
        <textarea id="bContent" rows="8" placeholder="例如：\n$$E = mc^2$$\n\n能量等於質量乘以光速的平方。">${escapeHtml(b.content || '')}</textarea>
      </div>
      <div style="font-size:12px; color:#8e8e93; padding:10px 12px; background:#f5f5f7; border-radius:8px; margin-top:6px;">
        💡 預覽預設顯示小綠圓「答」，點擊展開完整答案。<b>打印 PDF 時永遠只顯示圓圈，不顯示答案</b>，適合電子書先行、避免學生預先看到答案。
      </div>
    `;
  }
  if (b.type === 'objectives') {
    return `
      <div class="field">
        <label>學習目標（每行一項，預覽會自動兩欄排版）</label>
        <textarea id="bItems" rows="6" placeholder="理解 XXX\n說明 XXX\n區分 XXX">${escapeHtml((b.items || []).join('\n'))}</textarea>
      </div>
    `;
  }
  if (b.type === 'keyideas') {
    return `
      <div class="field">
        <label>Key points（支援 Markdown）</label>
        <textarea id="bContent" rows="5">${escapeHtml(b.content)}</textarea>
      </div>
    `;
  }
  if (b.type === 'formula') {
    return `
      <div class="field">
        <label>LaTeX 原始碼（KaTeX 渲染）</label>
        <textarea id="bLatex" class="mono" rows="3" placeholder="例如：F = ma 或 \\\\frac{d}{dx} e^x = e^x">${escapeHtml(b.latex || '')}</textarea>
        <div style="margin-top:6px; font-size:11.5px; color:#8e8e93;">
          支援所有 KaTeX 語法。行內請用 <code>$...$</code>，顯示式直接寫。
        </div>
      </div>
      <div class="field">
        <label>即時預覽</label>
        <div id="bFormulaPreview" style="padding:14px; background:#fafbfc; border-radius:8px; text-align:center; min-height:40px;"></div>
      </div>
      <div class="row">
        <div class="field">
          <label>編號（留空自動編為 Eq 章.序號）</label>
          <input type="text" id="bLabel" value="${escapeAttr(b.label || '')}" placeholder="Eq 1.1" />
        </div>
        <div class="field">
          <label>公式說明（選填）</label>
          <input type="text" id="bCaption" value="${escapeAttr(b.caption || '')}" placeholder="牛頓第二運動定律" />
        </div>
      </div>
      <div class="field">
        <label style="display:flex; align-items:center; gap:8px; text-transform:none; letter-spacing:0; color:#1c1c1e; font-weight:500; font-size:13px; cursor:pointer;">
          <input type="checkbox" id="bNumbered" ${b.numbered !== false ? 'checked' : ''} style="width:auto; margin:0;" />
          顯示右側編號（取消勾選 = 不顯示編號）
        </label>
      </div>
    `;
  }
  if (b.type === 'point') {
    return `
      <div class="field">
        <label>重點內容（支援 Markdown）</label>
        <textarea id="bText" rows="4" placeholder="例如：本章節的重點是理解 X 與 Y 的關係...">${escapeHtml(b.text || '')}</textarea>
      </div>
    `;
  }
  if (b.type === 'think') {
    return `
      <div class="field">
        <label>引導問題</label>
        <textarea id="bQuestion" rows="3" placeholder="例如：日常中常見的「速度」究竟是什麼？">${escapeHtml(b.question || '')}</textarea>
      </div>
      <div class="field">
        <label>提示（選填）</label>
        <input type="text" id="bHint" value="${escapeAttr(b.hint || '')}" placeholder="引導學生思考的提示" />
      </div>
    `;
  }
  if (b.type === 'caution') {
    return `
      <div class="field">
        <label>注意要點（每行一項，自動編號 1, 2, 3...）</label>
        <textarea id="bItems" rows="6" placeholder="單位時間 時間 s(秒) 時，單位時間是 1s。&#10;/ 是「每」的意思。">${escapeHtml((b.items || []).join('\n'))}</textarea>
      </div>
    `;
  }
  if (b.type === 'question') {
    return `
      <div class="field">
        <label>題目文字（顯示在問 N 框旁）</label>
        <input type="text" id="bText" value="${escapeAttr(b.text || '')}" placeholder="例如：某人 60m 跑 8.0 秒，速度是多少 m/s？" />
      </div>
      <div class="field">
        <label>題號（留空自動編為 問 章.序號）</label>
        <input type="text" id="bNum" value="${escapeAttr(String(b.num || ''))}" placeholder="1.1" />
      </div>
    `;
  }
  if (b.type === 'answerlines') {
    return `
      <div class="field">
        <label>標題（可選，例如：作答區、解題過程、計算草稿）</label>
        <input type="text" id="bLabel" value="${escapeAttr(b.label || '')}" placeholder="留空則不顯示標題" />
      </div>
      <div class="row">
        <div class="field">
          <label>行數</label>
          <input type="number" id="bLines" value="${parseInt(b.lines, 10) || 5}" min="1" max="50" step="1" />
        </div>
        <div class="field">
          <label>行距 (mm)</label>
          <input type="number" id="bLineHeight" value="${parseFloat(b.lineHeight) || 9}" min="4" max="20" step="0.5" />
        </div>
      </div>
      <div class="hint">在 A4 主欄中預設 5 行 × 9mm 行距，適合學生手寫作答。可調高行距（10–11mm）給中年級書寫空間。</div>
    `;
  }
  if (b.type === 'pagebreak') {
    return `
      <div class="hint" style="font-size:13px; line-height:1.6;">
        <strong>📄 換頁區塊（控制項）</strong><br>
        插入此區塊後，<b>下一個內容區塊會強制從新一頁開始</b>。<br>
        適合在重要例題、實驗、章節小結前手動斷頁，避免被自動分頁切得不好看。<br>
        <span style="color:#8e8e93;">此區塊在預覽會顯示虛線「— 換頁 —」標記，匯出 PDF 時不會出現，只會真的分頁。</span>
      </div>
    `;
  }
  if (b.type === 'spacer') {
    return `
      <div class="field">
        <label>空白行高度 (mm)</label>
        <input type="number" id="bHeight" value="${parseInt(b.height, 10) || 8}" min="1" max="80" step="1" />
      </div>
      <div class="hint">用於控制排版垂直留白，不會換頁。常見：例題前後 4–6mm、章節小結 8–10mm。</div>
      <div class="field" style="margin-top:10px;">
        <label>快速設定</label>
        <div id="bSpacerPresets" style="display:flex; gap:6px;">
          ${[2, 4, 6, 8, 12, 20].map(v => `
            <button type="button" data-h="${v}" style="flex:1; padding:7px 2px; border-radius:7px; border:1px solid rgba(60,60,67,0.15); background:white; color:#1c1c1e; font-size:12.5px; font-weight:500; cursor:pointer;">${v}mm</button>
          `).join('')}
        </div>
      </div>
    `;
  }
  if (b.type === 'mc') {
    const opts = (b.options && b.options.length ? b.options : ['', '', '', '']).slice(0, 6);
    while (opts.length < 4) opts.push('');
    const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
    return `
      <div class="row">
        <div class="field" style="flex:0 0 80px;">
          <label>題號</label>
          <input type="text" id="bNum" value="${escapeAttr(b.num || '')}" placeholder="自動" />
        </div>
        <div class="field" style="flex:1;">
          <label>題目（支援 LaTeX $...$ / $$...$$）</label>
          <textarea id="bQuestion" rows="3" placeholder="題幹文字、公式、變數...">${escapeHtml(b.question || '')}</textarea>
        </div>
      </div>
      <div class="field">
        <label>題目圖片（可選；如有圖，順序為：圖 → 題目 → 選項）</label>
        <div style="display:flex; gap:6px;">
          <input type="text" id="bImage" value="${escapeAttr(b.image || '')}" placeholder="https://..." style="flex:1;" />
          <button id="bImgUploadBtn" type="button" style="flex-shrink:0; padding:9px 14px; border-radius:8px; border:1px solid rgba(0,122,255,0.3); background:rgba(0,122,255,0.08); color:#007aff; font-size:13px; font-weight:500; cursor:pointer; white-space:nowrap;">📤 上傳</button>
        </div>
        <input type="file" id="bImgFileInput" accept="image/*" style="display:none;" />
        <div id="bImgUploadStatus" style="margin-top:6px; font-size:11.5px; color:#8e8e93; min-height:14px;"></div>
        <input type="text" id="bImageCaption" value="${escapeAttr(b.imageCaption || '')}" placeholder="圖說（可選）" style="margin-top:6px;" />
      </div>
      <div class="field">
        <label>選項（最少 2 個，最多 6 個；點選下方的正確答案）</label>
        <div id="bMcOptions" style="display:flex; flex-direction:column; gap:6px;">
          ${opts.map((o, i) => `
            <div style="display:flex; align-items:center; gap:6px;">
              <label style="display:flex; align-items:center; gap:4px; cursor:pointer; padding:4px 8px; border-radius:6px; background:${parseInt(b.answer, 10) === i ? 'rgba(28,138,78,0.12)' : 'transparent'}; border:1px solid ${parseInt(b.answer, 10) === i ? '#1c8a4e' : 'transparent'};">
                <input type="radio" name="bMcAnswer" value="${i}" ${parseInt(b.answer, 10) === i ? 'checked' : ''} style="margin:0;" />
                <span style="font-family:'Inter'; font-weight:800; color:${parseInt(b.answer, 10) === i ? '#1c8a4e' : '#8e8e93'};">${letters[i]}</span>
              </label>
              <input type="text" data-opt="${i}" value="${escapeAttr(o)}" placeholder="選項 ${letters[i]}" style="flex:1;" />
            </div>
          `).join('')}
        </div>
      </div>
      <div class="field">
        <label>解析（可選；學生答錯時一併顯示）</label>
        <textarea id="bExplanation" rows="2" placeholder="為什麼答案是這個選項？">${escapeHtml(b.explanation || '')}</textarea>
      </div>
      <div class="hint">預覽模式下，學生可點選作答；列印 PDF 時互動隱藏、自動標示正確答案。</div>
    `;
  }
  if (b.type === 'table') {
    const headers = b.headers || [];
    const rows = b.rows || [];
    const cols = headers.length;
    const align = b.align || [];
    const safeCols = Math.max(1, Math.min(8, cols));
    const safeRows = Math.max(0, Math.min(30, rows.length));
    return `
      <div class="row">
        <div class="field" style="flex:0 0 110px;">
          <label>表格編號</label>
          <input type="text" id="bNum" value="${escapeAttr(b.num || '')}" placeholder="自動" />
        </div>
        <div class="field" style="flex:1;">
          <label>標題（顯示在表格下方）</label>
          <input type="text" id="bCaption" value="${escapeAttr(b.caption || '')}" placeholder="表 1-1 SI 基本單位..." />
        </div>
      </div>
      <div class="field">
        <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
          <input type="checkbox" id="bNumbered" ${b.numbered !== false ? 'checked' : ''} style="margin:0;" />
          <span>自動編號（表 章.序號）</span>
        </label>
      </div>
      <div class="field">
        <label>表格大小（直接輸入列數 × 欄數，按「套用」展開）</label>
        <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
          <span style="font-size:12.5px; color:#6e6e73;">列</span>
          <input type="number" id="bTableRows" value="${Math.max(1, Math.min(30, b.rows.length))}" min="1" max="30" step="1" style="width:64px;" />
          <span style="font-size:12.5px; color:#6e6e73;">× 欄</span>
          <input type="number" id="bTableCols" value="${safeCols}" min="1" max="8" step="1" style="width:64px;" />
          <button type="button" id="bTableResize" style="padding:7px 14px; border-radius:7px; border:1px solid #007aff; background:rgba(0,122,255,0.10); color:#007aff; font-size:12.5px; font-weight:600; cursor:pointer;">套用</button>
          <span style="font-size:11.5px; color:#8e8e93;">現有資料會保留，超出會被截掉。</span>
        </div>
      </div>
      <div class="field">
        <label>平均欄寬 (mm)（0 或留空 = 自動均分欄寬）</label>
        <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
          <input type="number" id="bColWidth" value="${parseFloat(b.colWidth) || 0}" min="0" max="80" step="1" style="width:80px;" />
          <span style="font-size:11.5px; color:#8e8e93;">mm / 欄</span>
          <span style="font-size:11.5px; color:#8e8e93;">｜ 例：25 = 每欄 25mm；A4 主欄寬約 168mm，可放 6 欄左右</span>
          <button type="button" id="bColWidthAuto" style="font-size:11px; padding:4px 10px; border-radius:6px; border:1px solid rgba(60,60,67,0.15); background:white; color:#1c1c1e; cursor:pointer;">恢復自動</button>
        </div>
      </div>
      <div class="field">
        <label>表格內容（每格支援 LaTeX $...$ / $$...$$）</label>
        <div id="bTableGrid" style="display:grid; grid-template-columns: 28px repeat(${safeCols}, 1fr) 28px; gap:4px; align-items:stretch; background:rgba(0,0,0,0.02); border:1px solid rgba(60,60,67,0.1); border-radius:6px; padding:8px;">
          <div></div>
          ${headers.slice(0, safeCols).map((h, ci) => `
            <div style="display:flex; flex-direction:column; gap:3px;">
              <input type="text" data-tbl="h" data-ci="${ci}" value="${escapeAttr(h)}" placeholder="欄 ${ci + 1}" style="font-size:12px; padding:5px 6px; font-weight:600; background:#1c1c1e; color:white; border:none; border-radius:4px;" />
              <select data-tbl="align" data-ci="${ci}" style="font-size:11px; padding:3px 4px; border:1px solid rgba(60,60,67,0.15); border-radius:4px; background:white;">
                <option value="left" ${(align[ci] || 'left') === 'left' ? 'selected' : ''}>左</option>
                <option value="center" ${(align[ci] || 'left') === 'center' ? 'selected' : ''}>中</option>
                <option value="right" ${(align[ci] || 'left') === 'right' ? 'selected' : ''}>右</option>
              </select>
            </div>
          `).join('')}
          <button type="button" data-tbl="addcol" title="加一欄" style="border:1px dashed rgba(60,60,67,0.3); background:white; border-radius:4px; color:#6e6e73; cursor:pointer; font-size:16px;">＋</button>
          ${rows.slice(0, safeRows).map((r, ri) => `
            <button type="button" data-tbl="delrow" data-ri="${ri}" title="刪除此列" style="border:1px solid rgba(255,59,48,0.2); background:white; border-radius:4px; color:#ff3b30; cursor:pointer; font-size:12px;">✕</button>
            ${Array.from({length: safeCols}, (_, ci) => `
              <input type="text" data-tbl="c" data-ri="${ri}" data-ci="${ci}" value="${escapeAttr(r[ci] || '')}" placeholder="儲存格" style="font-size:12px; padding:5px 6px; border:1px solid rgba(60,60,67,0.15); border-radius:4px; background:white;" />
            `).join('')}
            <div></div>
          `).join('')}
          <button type="button" data-tbl="addrow" title="加一列" style="grid-column: 1 / -1; margin-top:4px; border:1px dashed rgba(60,60,67,0.3); background:white; border-radius:4px; color:#6e6e73; cursor:pointer; padding:6px; font-size:13px;">＋ 加一列</button>
        </div>
        <div style="display:flex; gap:8px; margin-top:8px;">
          <button type="button" data-tbl="delcol" style="font-size:12px; padding:5px 10px; border-radius:6px; border:1px solid rgba(255,59,48,0.3); background:white; color:#ff3b30; cursor:pointer;">✕ 刪除最後一欄</button>
          <span style="font-size:11.5px; color:#8e8e93; align-self:center;">提示：每格可輸入 LaTeX，例如 <code style="background:#f0f0f0; padding:1px 4px; border-radius:3px;">$v = \\frac{d}{t}$</code> 會在預覽渲染為分數。</span>
        </div>
      </div>
    `;
  }
  return '<p>不支援的區塊類型</p>';
}

function bindBlockEditor(b) {
  if (b.type === 'markdown' || b.type === 'keyideas' || b.type === 'answer') {
    const c = document.getElementById('bContent');
    if (c) c.oninput = e => { b.content = e.target.value; renderPreview(); };
    if (b.type === 'answer') {
      const lab = document.getElementById('bLabel');
      if (lab) lab.oninput = e => { b.label = e.target.value; renderPreview(); };
    }
  } else if (b.type === 'image') {
    document.getElementById('bUrl').oninput = e => { b.url = e.target.value; renderPreview(); };
    document.getElementById('bCaption').oninput = e => { b.caption = e.target.value; renderPreview(); };

    // ImgBB upload
    const uploadBtn = document.getElementById('bUploadBtn');
    const fileInput = document.getElementById('bFileInput');
    const status = document.getElementById('bUploadStatus');

    uploadBtn.onclick = () => fileInput.click();
    fileInput.onchange = async (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        status.innerHTML = '<span style="color:#ff3b30;">✗ 請選擇圖片檔案</span>';
        return;
      }

      const origText = uploadBtn.textContent;
      uploadBtn.textContent = '上傳中…';
      uploadBtn.disabled = true;
      status.innerHTML = '<span style="color:#8e8e93;">正在上傳到 ImgBB…</span>';

      try {
        const url = await uploadToImgbb(file);
        b.url = url;
        document.getElementById('bUrl').value = url;
        status.innerHTML = `<span style="color:#1c8a4e;">✓ 上傳成功！${file.name} (${(file.size/1024).toFixed(0)} KB)</span>`;
        renderEditor(); // refresh to show preview thumbnail
        renderPreview();
      } catch (err) {
        status.innerHTML = `<span style="color:#ff3b30;">✗ ${escapeHtml(err.message)}</span>`;
      } finally {
        uploadBtn.textContent = origText;
        uploadBtn.disabled = false;
        fileInput.value = '';
      }
    };

    // Image size buttons (125/100/75/50 %)
    document.querySelectorAll('#bImgSizeBtns button').forEach(btn => {
      btn.onclick = () => {
        b.width = parseInt(btn.dataset.size, 10);
        renderEditor();   // re-render to update button highlight
        renderPreview();
      };
    });
    // Image align buttons (left / center / right)
    document.querySelectorAll('#bImgAlignBtns button').forEach(btn => {
      btn.onclick = () => {
        b.align = btn.dataset.align;
        renderEditor();   // re-render to update button highlight
        renderPreview();
        const w = parseInt(b.width, 10) || 100;
        const label = btn.dataset.align === 'left' ? '靠左對齊' : btn.dataset.align === 'right' ? '靠右對齊' : '置中對齊';
        if (w >= 100) {
          showToast('圖片' + label + '（寬度 100% 已佔滿欄寬，建議先拖小一點再看差異）', 'info');
        } else {
          showToast('圖片' + label, 'info');
        }
      };
    });
  } else if (b.type === 'youtube') {
    document.getElementById('bVid').oninput = e => { b.videoId = e.target.value; renderPreview(); };
    document.getElementById('bCaption').oninput = e => { b.caption = e.target.value; renderPreview(); };
  } else if (b.type === 'objectives') {
    document.getElementById('bItems').oninput = e => {
      b.items = e.target.value.split('\n').map(x => x.trim()).filter(Boolean);
      renderPreview();
    };
  } else if (b.type === 'formula') {
    const latexEl = document.getElementById('bLatex');
    const labelEl = document.getElementById('bLabel');
    const captionEl = document.getElementById('bCaption');
    const numberedEl = document.getElementById('bNumbered');
    const previewEl = document.getElementById('bFormulaPreview');

    const renderPreviewFormula = () => {
      const src = b.latex || '\\text{（輸入 LaTeX）}';
      try {
        if (window.katex) {
          previewEl.innerHTML = katex.renderToString(src, { displayMode: true, throwOnError: false });
        } else {
          previewEl.textContent = src;
        }
      } catch (e) {
        previewEl.innerHTML = '<span style="color:#ff3b30;">LaTeX 錯誤</span>';
      }
    };

    const update = () => {
      renderPreviewFormula();
      renderPreview();
    };

    latexEl.oninput = e => { b.latex = e.target.value; update(); };
    labelEl.oninput = e => { b.label = e.target.value; renderPreview(); };
    captionEl.oninput = e => { b.caption = e.target.value; renderPreview(); };
    numberedEl.onchange = e => { b.numbered = e.target.checked; renderPreview(); };

    renderPreviewFormula();
  } else if (b.type === 'point') {
    document.getElementById('bText').oninput = e => { b.text = e.target.value; renderPreview(); };
  } else if (b.type === 'think') {
    document.getElementById('bQuestion').oninput = e => { b.question = e.target.value; renderPreview(); };
    const hintEl = document.getElementById('bHint');
    if (hintEl) hintEl.oninput = e => { b.hint = e.target.value; renderPreview(); };
  } else if (b.type === 'caution') {
    document.getElementById('bItems').oninput = e => {
      b.items = e.target.value.split('\n').map(x => x.trim()).filter(Boolean);
      renderPreview();
    };
  } else if (b.type === 'question') {
    document.getElementById('bText').oninput = e => { b.text = e.target.value; renderPreview(); };
    document.getElementById('bNum').oninput = e => { b.num = e.target.value; renderPreview(); };
  } else if (b.type === 'answerlines') {
    const labelEl = document.getElementById('bLabel');
    const linesEl = document.getElementById('bLines');
    const lhEl = document.getElementById('bLineHeight');
    if (labelEl) labelEl.oninput = e => { b.label = e.target.value; renderPreview(); };
    linesEl.oninput = e => {
      const v = parseInt(e.target.value, 10);
      b.lines = isNaN(v) ? 5 : Math.max(1, Math.min(50, v));
      renderPreview();
    };
    lhEl.oninput = e => {
      const v = parseFloat(e.target.value);
      b.lineHeight = isNaN(v) ? 9 : Math.max(4, Math.min(20, v));
      renderPreview();
    };
  } else if (b.type === 'spacer') {
    const heightEl = document.getElementById('bHeight');
    heightEl.oninput = e => {
      const v = parseInt(e.target.value, 10);
      b.height = isNaN(v) ? 8 : Math.max(1, Math.min(80, v));
      renderPreview();
    };
    document.querySelectorAll('#bSpacerPresets button').forEach(btn => {
      btn.onclick = () => {
        b.height = parseInt(btn.dataset.h, 10);
        heightEl.value = b.height;
        renderPreview();
      };
    });
  } else if (b.type === 'mc') {
    document.getElementById('bNum').oninput = e => { b.num = e.target.value; renderPreview(); };
    document.getElementById('bQuestion').oninput = e => { b.question = e.target.value; renderPreview(); };
    document.getElementById('bImage').oninput = e => { b.image = e.target.value; renderPreview(); };
    document.getElementById('bImageCaption').oninput = e => { b.imageCaption = e.target.value; renderPreview(); };
    document.getElementById('bExplanation').oninput = e => { b.explanation = e.target.value; renderPreview(); };

    // Option text inputs
    document.querySelectorAll('#bMcOptions input[type="text"]').forEach(inp => {
      inp.oninput = e => {
        const i = parseInt(e.target.dataset.opt, 10);
        b.options[i] = e.target.value;
        renderPreview();
      };
    });

    // Answer radio
    document.querySelectorAll('input[name="bMcAnswer"]').forEach(r => {
      r.onchange = e => {
        b.answer = parseInt(e.target.value, 10);
        renderEditor();   // re-render to update highlight
        renderPreview();
      };
    });

    // Image upload (reuse uploadToImgbb)
    const upBtn = document.getElementById('bImgUploadBtn');
    const fileInp = document.getElementById('bImgFileInput');
    const status = document.getElementById('bImgUploadStatus');
    upBtn.onclick = () => fileInp.click();
    fileInp.onchange = async (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        status.innerHTML = '<span style="color:#ff3b30;">✗ 請選擇圖片檔案</span>';
        return;
      }
      const origText = upBtn.textContent;
      upBtn.textContent = '上傳中…'; upBtn.disabled = true;
      status.innerHTML = '<span style="color:#8e8e93;">正在上傳到 ImgBB…</span>';
      try {
        const url = await uploadToImgbb(file);
        b.image = url;
        document.getElementById('bImage').value = url;
        status.innerHTML = `<span style="color:#1c8a4e;">✓ 上傳成功！${file.name}</span>`;
        renderPreview();
      } catch (err) {
        status.innerHTML = `<span style="color:#ff3b30;">✗ ${escapeHtml(err.message)}</span>`;
      } finally {
        upBtn.textContent = origText; upBtn.disabled = false; fileInp.value = '';
      }
    };
  } else if (b.type === 'table') {
    document.getElementById('bNum').oninput = e => { b.num = e.target.value; renderPreview(); };
    document.getElementById('bCaption').oninput = e => { b.caption = e.target.value; renderPreview(); };
    document.getElementById('bNumbered').onchange = e => { b.numbered = e.target.checked; renderPreview(); };

    // Average column width (mm) — applies to every column; 0 = auto
    const colWidthEl = document.getElementById('bColWidth');
    if (colWidthEl) {
      colWidthEl.oninput = e => {
        const v = parseFloat(e.target.value);
        b.colWidth = isNaN(v) ? 0 : Math.max(0, Math.min(80, v));
        renderPreview();
      };
    }
    const colWidthAuto = document.getElementById('bColWidthAuto');
    if (colWidthAuto) {
      colWidthAuto.onclick = () => {
        b.colWidth = 0;
        if (colWidthEl) colWidthEl.value = 0;
        renderPreview();
      };
    }

    // Resize (rows × cols) — input numbers then click 套用
    const resizeBtn = document.getElementById('bTableResize');
    if (resizeBtn) resizeBtn.onclick = () => {
      const rowsInp = document.getElementById('bTableRows');
      const colsInp = document.getElementById('bTableCols');
      const newRows = Math.max(1, Math.min(30, parseInt(rowsInp.value, 10) || 1));
      const newCols = Math.max(1, Math.min(8, parseInt(colsInp.value, 10) || 1));

      // Make sure arrays exist (defensive — for legacy data)
      if (!Array.isArray(b.headers)) b.headers = [];
      if (!Array.isArray(b.align))   b.align = [];
      if (!Array.isArray(b.rows))    b.rows = [];

      // --- Resize COLUMNS (headers + align + every row's cell count) ---
      // Grow
      while (b.headers.length < newCols) b.headers.push(`欄 ${b.headers.length + 1}`);
      while (b.align.length   < newCols) b.align.push('left');
      // Shrink (use splice to be explicit, in case length assignment is ignored)
      if (b.headers.length > newCols) b.headers.splice(newCols);
      if (b.align.length   > newCols) b.align.splice(newCols);

      // --- Resize ROWS ---
      // Grow
      while (b.rows.length < newRows) {
        b.rows.push(Array.from({length: newCols}, () => ''));
      }
      // Shrink
      if (b.rows.length > newRows) b.rows.splice(newRows);

      // --- Normalize each row's cell count to newCols ---
      b.rows.forEach((r, i) => {
        if (!Array.isArray(r)) b.rows[i] = [];
        const row = b.rows[i];
        while (row.length < newCols) row.push('');
        if (row.length > newCols) row.splice(newCols);
      });

      // Sync the inputs to the actual (clamped) values so the user sees them
      rowsInp.value = b.rows.length;
      colsInp.value = b.headers.length;

      renderEditor();   // re-render to refresh grid + inputs
      renderPreview();
    };

    const bind = () => {
      // Header cell inputs
      document.querySelectorAll('#bTableGrid input[data-tbl="h"]').forEach(inp => {
        inp.oninput = e => {
          const ci = parseInt(e.target.dataset.ci, 10);
          b.headers[ci] = e.target.value;
          renderPreview();
        };
      });
      // Body cell inputs
      document.querySelectorAll('#bTableGrid input[data-tbl="c"]').forEach(inp => {
        inp.oninput = e => {
          const ri = parseInt(e.target.dataset.ri, 10);
          const ci = parseInt(e.target.dataset.ci, 10);
          b.rows[ri][ci] = e.target.value;
          renderPreview();
        };
      });
      // Alignment selects
      document.querySelectorAll('#bTableGrid select[data-tbl="align"]').forEach(sel => {
        sel.onchange = e => {
          const ci = parseInt(e.target.dataset.ci, 10);
          b.align[ci] = e.target.value;
          renderPreview();
        };
      });
      // Add column
      const addCol = document.querySelector('#bTableGrid button[data-tbl="addcol"]');
      if (addCol) addCol.onclick = () => {
        b.headers.push(`欄 ${b.headers.length + 1}`);
        b.rows.forEach(r => r.push(''));
        b.align.push('left');
        renderEditor(); renderPreview();
      };
      // Add row
      const addRow = document.querySelector('#bTableGrid button[data-tbl="addrow"]');
      if (addRow) addRow.onclick = () => {
        const nc = b.headers.length || 1;
        b.rows.push(Array.from({length: nc}, () => ''));
        renderEditor(); renderPreview();
      };
      // Delete column (last)
      const delCol = document.querySelector('button[data-tbl="delcol"]');
      if (delCol) delCol.onclick = () => {
        if (b.headers.length <= 1) return;
        b.headers.pop();
        b.rows.forEach(r => r.pop());
        b.align.pop();
        renderEditor(); renderPreview();
      };
      // Delete specific row
      document.querySelectorAll('#bTableGrid button[data-tbl="delrow"]').forEach(btn => {
        btn.onclick = () => {
          const ri = parseInt(btn.dataset.ri, 10);
          if (b.rows.length <= 1) return;
          b.rows.splice(ri, 1);
          renderEditor(); renderPreview();
        };
      });
    };
    bind();
  }
}

function getBlockPreview(b) {
  if (b.type === 'markdown') return b.content.slice(0, 80).replace(/\n/g, ' ');
  if (b.type === 'image') return b.caption || b.url || '(未設定)';
  if (b.type === 'youtube') return b.caption || b.videoId || '(未設定)';
  if (b.type === 'objectives') return (b.items || []).slice(0, 2).join('、');
  if (b.type === 'keyideas') return b.content.slice(0, 80).replace(/\n/g, ' ');
  if (b.type === 'formula') return b.caption || b.label || (b.latex ? b.latex.slice(0, 50) : '(未設定)');
  if (b.type === 'point') return (b.text || '').slice(0, 80).replace(/\n/g, ' ');
  if (b.type === 'think') return b.question || '(未設定)';
  if (b.type === 'caution') return (b.items || []).slice(0, 2).join('、');
  if (b.type === 'question') return b.text || '(未設定)';
  if (b.type === 'answerlines') {
    const n = parseInt(b.lines, 10) || 5;
    const prefix = b.label ? `${b.label} · ` : '';
    return `${prefix}${n} 行作答橫線`;
  }
  if (b.type === 'pagebreak') return '— 換頁，下一塊開始新一頁 —';
  if (b.type === 'spacer') return `${parseInt(b.height, 10) || 8}mm 垂直留白`;
  if (b.type === 'mc') {
    const n = (b.options || []).filter(x => x && x.trim()).length;
    return b.question ? `選擇題 · ${n} 選項` : '(未設定題目)';
  }
  if (b.type === 'table') {
    const cols = (b.headers || []).length;
    const rows = (b.rows || []).length;
    const cap = b.caption ? `${b.caption} · ` : '';
    return `表格 · ${cap}${cols}欄 × ${rows}列`;
  }
  return '';
}

/* ----- Halftone Watermark (algorithm-generated, non-repeating) ----- */
let halftoneBgUrl = null;

function generateHalftoneSVG(w, h) {
  // Full-width, full-height SVG — gradient runs once across the chapter header
  // Density: sparse (left) → dense (right)
  // Size:    tiny (left) → large (right)
  const cellSize = 9;
  const cols = Math.floor(w / cellSize);
  const rows = Math.floor(h / cellSize);
  const maxR = cellSize * 0.48;
  const minR = 0.15;

  const parts = [];
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      // Position jitter
      const jx = Math.sin(c * 12.9898 + r * 78.233) * cellSize * 0.10;
      const jy = Math.cos(c * 39.346 + r * 11.135) * cellSize * 0.10;
      const x = c * cellSize + cellSize / 2 + jx;
      const y = r * cellSize + cellSize / 2 + jy;

      // Base size: gradient from left (small) to right (large)
      const t = c / Math.max(1, cols - 1);
      let factor = Math.pow(t, 0.5);

      // Organic noise
      const n = Math.sin(c * 0.73 + r * 1.31) * 0.10
              + Math.cos(c * 0.41 - r * 0.83) * 0.08;
      factor = Math.max(0, Math.min(1, factor + n));

      // Density gradient: skip more dots on the left
      const densityThreshold = 0.50 * (1 - t);
      if (factor < densityThreshold) continue;

      // Extra stochastic skip on the left
      const skipSeed = Math.sin(c * 7.13 + r * 3.71) * 0.5 + 0.5;
      const skipChance = (1 - t) * 0.35;
      if (skipSeed < skipChance) continue;

      const radius = minR + (maxR - minR) * factor;
      const opacity = 0.18 + factor * 0.34;
      parts.push(`<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${radius.toFixed(2)}" fill="#ff9a4a" opacity="${opacity.toFixed(2)}"/>`);
    }
  }

  return `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">${parts.join('')}</svg>`;
}

function initHalftoneBackground() {
  // Generate one large SVG matching the full chapter header area (no repeat)
  // Page is 210mm wide → ~794 CSS px; chapter header height ≈ 28mm → ~106 CSS px
  // Height set generously (160px) so the pattern fills the entire header when stretched
  const svg = generateHalftoneSVG(800, 160);
  const blob = new Blob([svg], { type: 'image/svg+xml' });
  halftoneBgUrl = URL.createObjectURL(blob);
}

function applyHalftoneBackground() {
  if (!halftoneBgUrl) return;
  document.querySelectorAll('.chapter-header').forEach(el => {
    if (!el.style.backgroundImage) {
      el.style.backgroundImage = `url("${halftoneBgUrl}")`;
      el.style.backgroundSize = '100% 100%';
      el.style.backgroundRepeat = 'no-repeat';
    }
  });
}

/* ----- Render: Preview blocks HTML ----- */

function renderBlockHTML(b) {
  if (b.type === 'spacer') {
    const h = Math.max(1, Math.min(80, parseInt(b.height, 10) || 8));
    return `<div class="b-spacer" style="height:${h}mm;"></div>`;
  }
  if (b.type === 'table') {
    const headers = b.headers || [];
    const rows = b.rows || [];
    const align = b.align || [];
    const colCount = headers.length;
    // Per-column width (mm) — 0 means "auto / equal share" (default)
    const cw = Math.max(0, parseFloat(b.colWidth) || 0);
    const cwStyle = (cw > 0) ? ` style="width:${cw}mm; min-width:${cw}mm;"` : '';
    if (colCount === 0) {
      return `<div class="b-table"><div class="tbl-wrap"><div style="padding:15mm; text-align:center; color:#8e8e93;">（空表格）</div></div></div>`;
    }
    const theadHtml = `<thead><tr>${headers.map((h, ci) => {
      const a = align[ci] || 'left';
      return `<th class="tbl-align-${a}"${cwStyle}>${marked.parse(renderMarkdownWithLatex(h || ''))}</th>`;
    }).join('')}</tr></thead>`;
    const tbodyHtml = rows.length > 0
      ? `<tbody>${rows.map(r => `<tr>${Array.from({length: colCount}, (_, ci) => {
          const a = align[ci] || 'left';
          const cell = r[ci] || '';
          return `<td class="tbl-align-${a}"${cwStyle}>${marked.parse(renderMarkdownWithLatex(cell))}</td>`;
        }).join('')}</tr>`).join('')}</tbody>`
      : '';
    const showNum = b.numbered !== false && b.num;
    const numHtml = showNum ? `<div class="tbl-num">表 ${escapeHtml(b.num)}</div>` : '';
    const capHtml = b.caption ? `<div class="tbl-caption">${escapeHtml(b.caption)}</div>` : '';
    return `<div class="b-table">
      <div class="tbl-wrap">
        <table>${theadHtml}${tbodyHtml}</table>
      </div>
      ${numHtml}${capHtml}
    </div>`;
  }
  if (b.type === 'mc') {
    const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
    const opts = (b.options || []).slice(0, 6);
    const correctIdx = parseInt(b.answer, 10) || 0;
    const num = b.num ? `<span class="mc-num">${escapeHtml(b.num)}</span>` : '';
    const imgHtml = b.image
      ? `<div class="mc-image-wrap"><img class="mc-image" src="${escapeAttr(b.image)}" style="max-width:${Math.max(25, Math.min(150, parseInt(b.imageWidth, 10) || 100))}%;" onerror="this.style.display='none';" />${b.imageCaption ? `<div class="mc-image-cap">${escapeHtml(b.imageCaption)}</div>` : ''}</div>`
      : '';
    const qHtml = b.question
      ? marked.parse(renderMarkdownWithLatex(b.question || ''))
      : '<span style="color:#8e8e93; font-style:italic;">（未設定題目）</span>';
    const optsHtml = opts.map((o, i) => {
      const text = o ? marked.parse(renderMarkdownWithLatex(o)) : `<span style="color:#c0c0c5;">（選項 ${letters[i]} 未設定）</span>`;
      const isCorrect = i === correctIdx;
      // Note: no answer marker in the rendered HTML — correct option only
      // gets the .correct class at runtime via mcAnswer(). Print mode has no
      // visual hint of which option is right (in-class use).
      return `<button type="button" class="mc-opt" data-idx="${i}" data-correct="${isCorrect ? 1 : 0}" onclick="mcAnswer(this, ${b.id ? `'${b.id}'` : 'null'}, ${i})">
        <span class="mc-opt-letter">${letters[i]}</span>
        <span class="mc-opt-text">${text}</span>
      </button>`;
    }).join('');
    const expl = b.explanation ? `<div class="mc-explanation" style="margin-top:3mm; font-size:10pt; color:#6e6e73; line-height:1.5;"><strong>解析：</strong>${marked.parse(renderMarkdownWithLatex(b.explanation))}</div>` : '';
    return `<div class="b-mc" id="mc-${escapeAttr(b.id)}" data-correct="${correctIdx}">
      <div class="mc-header">
        <span class="mc-badge">MC</span>
        ${num}
      </div>
      ${imgHtml}
      <div class="mc-question">${qHtml}</div>
      <div class="mc-options">${optsHtml}</div>
      <div class="mc-feedback" id="mc-fb-${escapeAttr(b.id)}"></div>
      ${expl}
      <button type="button" class="mc-reset" style="display:none;" onclick="mcReset(this)">↻ 再試一次</button>
    </div>`;
  }
  if (b.type === 'pagebreak') {
    return `<div class="b-pagebreak"></div>`;
  }
  if (b.type === 'answerlines') {
    const n = Math.max(1, Math.min(50, parseInt(b.lines, 10) || 5));
    const lh = Math.max(4, Math.min(20, parseFloat(b.lineHeight) || 9));
    const lines = Array.from({ length: n }, () => '<div class="al-line"></div>').join('');
    const labelHtml = b.label ? `<div class="al-label">${escapeHtml(b.label)}</div>` : '';
    return `<div class="b-answerlines" style="--al-lh:${lh}mm;">
      ${labelHtml}
      <div class="al-lines">${lines}</div>
    </div>`;
  }
  if (b.type === 'markdown') {
    return `<div class="b-markdown">${marked.parse(renderMarkdownWithLatex(b.content || ''))}</div>`;
  }
  if (b.type === 'image') {
    const w = Math.max(25, Math.min(150, parseInt(b.width, 10) || 100));
    const align = ['left', 'center', 'right'].includes(b.align) ? b.align : 'center';
    // No max-height cap — the chosen width is the chosen size. If the user
    // drags beyond page bounds, .page-wrap's overflow:hidden + paginateChapter
    // will break it across pages. They take responsibility for layout.
    // CRITICAL: wrap is a block with explicit inline `width: X%`. This avoids
    // the flex/inline-block cycle where wrap gets stretched to col width and
    // alignment becomes a no-op. img uses `width: 100%` (not max-width) so it
    // exactly fills the wrap.
    const wrapStyle = `width: ${w}%;`;
    const imgInner = b.url
      ? `<img class="b-image-img" src="${escapeAttr(b.url)}" alt="${escapeAttr(b.caption || '')}" style="width:100%;" onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<div style=\\'padding:20mm;background:#f0f0f0;color:#8e8e93;\\'>（圖片載入失敗）</div>');" />`
      : '<div class="b-image-empty" style="padding:15mm; background:#f5f5f7; color:#8e8e93; border-radius:2px;">（未設定圖片網址）</div>';
    const alignBar = b.url
      ? `<div class="b-image-align-bar" data-block-id="${b.id}">
           <button type="button" class="b-img-align ${align === 'left'   ? 'active' : ''}" data-align="left"   title="靠左對齊">⇤</button>
           <button type="button" class="b-img-align ${align === 'center' ? 'active' : ''}" data-align="center" title="置中">↔</button>
           <button type="button" class="b-img-align ${align === 'right'  ? 'active' : ''}" data-align="right"  title="靠右對齊">⇥</button>
         </div>`
      : '';
    return `<div class="b-image" data-block-id="${b.id}" data-cur-width="${w}">
      <div class="b-image-wrap" data-align="${align}" data-block-id="${b.id}" style="${wrapStyle}">${imgInner}${alignBar}${b.url ? '<span class="b-image-resize-handle" title="拖曳右下角調整大小"></span>' : ''}</div>
      ${b.caption ? `<div class="cap" style="text-align:${align};">${escapeHtml(b.caption)}</div>` : ''}
    </div>`;
  }
  if (b.type === 'youtube') {
    const vid = b.videoId || '';
    const safeVid = escapeAttr(vid);
    const safeCap = escapeAttr(b.caption || '觀看教學影片');
    const capHtml = escapeHtml(b.caption || '觀看教學影片');
    const vidHtml = escapeHtml(vid || '尚未設定');
    // ---- Capsule form: left play icon + right QR code, no other data ----
    if (vid) {
      const ytUrl = 'https://www.youtube.com/watch?v=' + encodeURIComponent(vid);
      // ecc=L → low error correction (~7%) → simpler / sparser QR (easier to scan)
      const qrSrc = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&ecc=L&data=' + encodeURIComponent(ytUrl);
      return `<a class="b-youtube-rect" href="${escapeAttr(ytUrl)}" target="_blank" rel="noopener" data-vid="${safeVid}" onclick="event.stopPropagation();">
        <span class="ytr-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
        <span class="ytr-qr"><img src="${escapeAttr(qrSrc)}" alt="QR" loading="lazy" /></span>
      </a>`;
    }
    // Empty placeholder
    return `<div class="b-youtube-rect empty">
      <span class="ytr-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
      <span class="ytr-qr" style="background:#f0f0f0; color:#8e8e93; font-size:10px; display:flex; align-items:center; justify-content:center;">尚未設定</span>
    </div>`;
  }
  if (b.type === 'answer') {
    // Collapsed: a small green "答" pill that doesn't take up flow space
    // (floats right). Click to expand. In @media print the expanded
    // content is hidden — the pill alone shows (so students printing the
    // book see the placeholder but not the actual answer).
    const isOpen = !!b.expanded;
    const label = b.label || '答案';
    if (isOpen) {
      return `<div class="b-answer b-answer-open" data-block-id="${b.id}">
        <button type="button" class="b-answer-circle" data-act="collapse" title="收合答案" aria-label="收合答案"><span>答</span></button>
        <div class="b-answer-expanded">
          <div class="b-answer-label">${escapeHtml(label)}</div>
          <div class="b-answer-body">${marked.parse(renderMarkdownWithLatex(b.content || ''))}</div>
        </div>
      </div>`;
    }
    return `<div class="b-answer" data-block-id="${b.id}">
      <button type="button" class="b-answer-circle" data-act="expand" title="${escapeAttr(label)} · 點擊展開" aria-label="展開答案"><span>答</span></button>
      <span class="b-answer-hint">${escapeHtml(label)} · 點擊展開</span>
    </div>`;
  }
  if (b.type === 'objectives') {
    return `<div class="b-objectives">
      <div class="obj-title">Learning Objectives · 學習目標</div>
      <div class="obj-grid">
        ${(b.items || []).map(it => `<div class="obj-item">${escapeHtml(it)}</div>`).join('')}
      </div>
    </div>`;
  }
  if (b.type === 'keyideas') {
    return `<div class="b-keyideas">
      <div class="ki-title">Key points</div>
      <div class="ki-content">${marked.parse(renderMarkdownWithLatex(b.content || ''))}</div>
    </div>`;
  }
  if (b.type === 'formula') {
    const src = b.latex || '';
    let mathHTML;
    if (!src) {
      mathHTML = '<span style="color:#8e8e93; font-style:italic;">（未設定 LaTeX）</span>';
    } else if (window.katex) {
      try {
        mathHTML = katex.renderToString(src, { displayMode: true, throwOnError: false });
      } catch (e) {
        mathHTML = `<div class="formula-error">LaTeX 錯誤：${escapeHtml(String(e.message || e))}</div>`;
      }
    } else {
      mathHTML = `<code>${escapeHtml(src)}</code>`;
    }
    const showNumber = b.numbered !== false;
    const label = b.label ? `<div class="formula-number">(${escapeHtml(b.label)})</div>` : '';
    const caption = b.caption ? `<div class="formula-caption">${escapeHtml(b.caption)}</div>` : '';
    return `<div class="b-formula">
      <div class="formula-row">
        <div class="formula-body" style="flex:1;">${mathHTML}</div>
        ${showNumber ? label : ''}
      </div>
      ${caption}
    </div>`;
  }
  if (b.type === 'point') {
    return `<div class="b-point">
      <div class="point-label">重點</div>
      <div class="point-body">${marked.parse(renderMarkdownWithLatex(b.text || ''))}</div>
    </div>`;
  }
  if (b.type === 'think') {
    return `<div class="b-think">
      <div class="think-label"><span class="think-q">?</span>想一想</div>
      <div class="think-body">${marked.parse(renderMarkdownWithLatex(b.question || ''))}</div>
      ${b.hint ? `<div class="think-hint">💡 ${escapeHtml(b.hint)}</div>` : ''}
    </div>`;
  }
  if (b.type === 'caution') {
    const items = b.items || [];
    return `<div class="b-caution">
      <div class="caution-title"><span class="caution-icon">!</span>注意</div>
      <ol class="caution-list">
        ${items.map((it, i) => `<li class="caution-item"><span class="caution-num">${i + 1}</span><span class="caution-text">${escapeHtml(it)}</span></li>`).join('')}
      </ol>
    </div>`;
  }
  if (b.type === 'question') {
    const num = b.num || '?';
    return `<div class="b-question">
      <span class="q-icon">問</span>
      <span class="q-text"><span class="q-num">${escapeHtml(num)}</span>${escapeHtml(b.text || '')}</span>
    </div>`;
  }
  return '';
}

function renderChapterHeaderHTML(c) {
  return `<div class="chapter-header">
    <div class="ch-watermark">${escapeHtml(String(c.number))}</div>
    <div class="ch-num">CHAPTER ${escapeHtml(String(c.number))}</div>
    <div class="ch-title">${escapeHtml(c.title || '')}</div>
    ${c.subtitle ? `<div class="ch-subtitle">${escapeHtml(c.subtitle)}</div>` : ''}
  </div>`;
}

function renderSectionHeaderHTML(s) {
  return `<div class="section-header">
    <div class="sh-num">${escapeHtml(s.number || '')}</div>
    <div class="sh-title">${escapeHtml(s.title || '')}</div>
  </div>`;
}

/* ----- Measurement (off-screen) ----- */
function measureHTML(html, widthMm) {
  const host = document.getElementById('measureHost');
  host.style.width = widthMm + 'mm';
  host.style.padding = '0';
  host.innerHTML = html;
  const hPx = host.getBoundingClientRect().height;
  host.innerHTML = '';
  return hPx / MM_TO_PX; // mm
}
function measureBlock(b) { return measureHTML(renderBlockHTML(b), CONTENT_W_MM); }
function measureChapterHeader(c) { return measureHTML(renderChapterHeaderHTML(c), PAGE_W_MM); }
function measureSectionHeader(s) { return measureHTML(renderSectionHeaderHTML(s), CONTENT_W_MM); }

/* ----- Auto-number formulas & questions ----- */
function autoNumberFormulas() {
  state.doc.chapters.forEach(c => {
    let formulaIdx = 0;
    let questionIdx = 0;
    let tableIdx = 0;
    c.sections.forEach(s => {
      s.blocks.forEach(b => {
        if (b.type === 'formula') {
          formulaIdx++;
          // 只在「全新未編輯」狀態（label 嚴格等於 0）才自動編號
          // 避免覆蓋使用者輸入或清空後的字串
          if (b.label === 0 || b.label == null) b.label = `${c.number}.${formulaIdx}`;
        }
        if (b.type === 'question') {
          questionIdx++;
          if (b.num === 0 || b.num == null) b.num = `${c.number}.${questionIdx}`;
        }
        if (b.type === 'table') {
          tableIdx++;
          if (b.numbered !== false && (b.num === 0 || b.num == null)) {
            b.num = `${c.number}.${tableIdx}`;
          }
        }
      });
    });
  });
}

/* ----- Pagination (two-column) -----
   mainItems now holds streamed entries: either a section header or a block.
   This way, when multiple sections fit on one page, each section keeps its
   own header rendered inline before its first block (no overwrite).
*/
function paginateChapter(c) {
  const pages = [];
  let page = {
    chapterHeader: null,
    sideItems: [], mainItems: [],
    sideHeight: 0, mainHeight: 0
  };
  const pushPage = () => {
    if (page.sideItems.length || page.mainItems.length || page.chapterHeader) pages.push(page);
  };
  const newPage = () => ({ chapterHeader: null, sideItems: [], mainItems: [], sideHeight: 0, mainHeight: 0 });

  // Chapter header (includes intro) — spans both columns
  const chH = measureChapterHeader(c);
  page.chapterHeader = c;
  page.sideHeight = chH;
  page.mainHeight = chH;

  /* Track whether the CURRENT page was started by a page-break block.
     When this flag is true and the page has content, the next section's
     header must NOT be placed on this page — otherwise post-pagebreak
     content from the previous section visually appears under the next
     section's header. */
  let pageStartedByPagebreak = false;

  // Sections — normal flow: sections can share pages. The only time we
  // push early is when a pagebreak created a new page and the next
  // section's header would otherwise be appended onto that same page.
  for (const s of c.sections) {
    // If the current page was started by a pagebreak and has content, push
    // it before starting the next section. This keeps the previous section's
    // post-pagebreak content on its own page, and gives the new section a
    // clean page to begin on.
    if (pageStartedByPagebreak && (page.mainItems.length > 0 || page.sideItems.length > 0)) {
      pushPage();
      page = newPage();
    }
    pageStartedByPagebreak = false;

    const shH = measureSectionHeader(s);

    // Build a flat main-stream for this section: section header first, then main blocks
    const mainStream = [{ kind: 'sectionHeader', s, h: shH }];
    for (const b of s.blocks) {
      if (b.column !== 'side') {
        mainStream.push({ kind: 'block', b, h: measureBlock(b) });
      }
    }
    // Side items for this section
    const sideStream = [];
    for (const b of s.blocks) {
      if (b.column === 'side') {
        sideStream.push({ kind: 'block', b, h: measureBlock(b) });
      }
    }

    // Stream main items — push page when overflowing; section header always goes
    // with the first main block of the section on each page (rendered inline).
    for (let i = 0; i < mainStream.length; i++) {
      const item = mainStream[i];
      // Look-ahead: is the next item a pagebreak?
      const nextIsPagebreak = i + 1 < mainStream.length
        && mainStream[i + 1].kind === 'block'
        && mainStream[i + 1].b.type === 'pagebreak';

      // Page break block: render its visual on the current page, then force fresh page
      if (item.kind === 'block' && item.b.type === 'pagebreak') {
        page.mainItems.push({ kind: 'block', b: item.b });
        page.mainHeight += item.h;
        pushPage();
        page = newPage();
        pageStartedByPagebreak = true;
        continue;
      }
      // Overflow check — but SKIP the push when the next item is a pagebreak.
      // Reason: a pagebreak right after means the user has explicitly chosen
      // a page boundary there. We should NOT split the "stuff before the
      // pagebreak" across two pages just because of an internal overflow —
      // the pagebreak will create a fresh page anyway. Keeping the items
      // together (even if the page becomes slightly overfull) matches the
      // user's mental model of "this is one logical chunk".
      if (page.mainHeight + item.h > CONTENT_H_MM && !nextIsPagebreak) {
        pushPage();
        page = newPage();
      }
      if (item.kind === 'sectionHeader') {
        page.mainItems.push({ kind: 'sectionHeader', s: item.s });
      } else {
        page.mainItems.push({ kind: 'block', b: item.b });
      }
      page.mainHeight += item.h;
    }

    // Stream side items — each block alone; if it overflows, push and start new page
    for (const item of sideStream) {
      if (item.kind === 'block' && item.b.type === 'pagebreak') {
        pushPage();
        page = newPage();
        pageStartedByPagebreak = true;
        continue;
      }
      if (page.sideHeight + item.h > CONTENT_H_MM) {
        pushPage();
        page = newPage();
      }
      page.sideItems.push(item.b);
      page.sideHeight += item.h;
    }
  }
  pushPage();
  return pages;
}

function renderPreview() {
  const root = document.getElementById('previewRoot');
  const pane = document.getElementById('previewScroll');
  // Save scroll position so the preview doesn't yank the user back to page 1
  // when content changes (e.g. adding a new block, editing text). The caller
  // can force a scroll by calling scrollToSelection(true) after renderAll.
  const savedScrollTop = pane ? pane.scrollTop : 0;

  root.innerHTML = '';

  autoNumberFormulas();

  if (state.doc.chapters.length === 0) {
    root.innerHTML = `
      <div class="preview-empty">
        <div style="font-size:48px; margin-bottom:14px; opacity:0.4;">📄</div>
        <h3>尚無內容</h3>
        <p>點擊左側「＋ 章」開始建立，<br>或直接從這裡載入一份 JSON 教材</p>
        <button class="btn btn-primary" id="pEmptyImportBtn" style="margin-top:18px;">↙ 載入 JSON 教材</button>
      </div>
    `;
    document.getElementById('pEmptyImportBtn').onclick = openImportDialog;
    document.getElementById('pageIndicator').textContent = '共 0 頁';
    return;
  }

  let totalPages = 0;
  const frag = document.createDocumentFragment();
  state.doc.chapters.forEach(c => {
    const pages = paginateChapter(c);
    pages.forEach(p => {
      totalPages++;
      const wrap = document.createElement('div');
      wrap.className = 'page-wrap';
      wrap.style.width = (PAGE_W_MM * state.zoom) + 'mm';
      wrap.style.height = (PAGE_H_MM * state.zoom) + 'mm';
      wrap.dataset.chapterId = c.id;

      const pageEl = document.createElement('div');
      pageEl.className = 'page';
      pageEl.style.transform = `scale(${state.zoom})`;

      // Always render the two-column layout (left side + right main) so the
      // page structure stays consistent across pages — even if a section has
      // no side items, the left column is reserved (empty) at 42mm wide.
      const hasSide = p.sideItems.length > 0;
      const hasMain = p.mainItems.length > 0;
      let inner = '<div class="page-content">';
      if (p.chapterHeader) inner += renderChapterHeaderHTML(p.chapterHeader);
      inner += '<div class="cols-wrap">';
      // Left column: always rendered (empty if no side items, so the 42mm slot
      // is reserved consistently).
      inner += '<div class="col-side">';
      if (hasSide) {
        p.sideItems.forEach(b => {
          inner += `<div class="b-anchor" data-block-id="${escapeAttr(b.id)}">${renderBlockHTML(b)}</div>`;
        });
      }
      inner += '</div>';
      // Right column (main): always rendered
      inner += '<div class="col-main">';
      if (hasMain) {
        p.mainItems.forEach(item => {
          if (item.kind === 'sectionHeader') {
            inner += `<div class="b-anchor" data-section-id="${escapeAttr(item.s.id)}">${renderSectionHeaderHTML(item.s)}</div>`;
          } else {
            inner += `<div class="b-anchor" data-block-id="${escapeAttr(item.b.id)}">${renderBlockHTML(item.b)}</div>`;
          }
        });
      }
      inner += '</div></div>';
      inner += '</div>';
      pageEl.innerHTML = inner;

      const pgNum = document.createElement('div');
      pgNum.className = 'page-number';
      pgNum.textContent = String(totalPages);
      pageEl.appendChild(pgNum);

      wrap.appendChild(pageEl);
      frag.appendChild(wrap);
    });
  });
  root.appendChild(frag);
  document.getElementById('pageIndicator').textContent = `共 ${totalPages} 頁`;
  applyHalftoneBackground();

  // Restore the saved scroll position (the DOM was rebuilt, browser would
  // otherwise reset it to 0 = top = page 1). Use rAF so layout has settled.
  // If the caller wants an explicit scroll (e.g. scrollToSelection), it
  // cancels this rAF so we don't clobber it.
  if (pane && savedScrollTop > 0) {
    if (_previewScrollRestoreRaf) cancelAnimationFrame(_previewScrollRestoreRaf);
    _previewScrollRestoreRaf = requestAnimationFrame(() => {
      _previewScrollRestoreRaf = null;
      pane.scrollTop = savedScrollTop;
    });
  }
}

function renderAll() {
  renderOutline();
  renderEditor();
  renderPreview();
  // Re-apply letter-spacing mode in case document content language changed
  applySpacingMode();
}

/* ----- Scroll preview to currently-selected item ----- */
function scrollToSelection(force) {
  const sel = state.selection;
  if (!sel || !sel.kind) return;
  const pane = document.getElementById('previewScroll');
  if (!pane) return;

  let target = null;
  if (sel.kind === 'chapter') {
    target = document.querySelector(`.page-wrap[data-chapter-id="${cssEscape(sel.chapterId)}"]`);
  } else if (sel.kind === 'section') {
    target = document.querySelector(`.b-anchor[data-section-id="${cssEscape(sel.sectionId)}"]`);
  } else if (sel.kind === 'block') {
    target = document.querySelector(`.b-anchor[data-block-id="${cssEscape(sel.blockId)}"]`);
  }
  if (!target) return;

  // Only scroll when the target is NOT already visible in the preview pane —
  // clicking the outline to edit shouldn't yank the user away from what
  // they're looking at. force = true always scrolls (used for AI inserts
  // where we just put the blocks there and want to take the user to them).
  if (!force && isElementInPane(target, pane)) return;

  // We're actually going to scroll — cancel the pending restore from
  // renderPreview so it doesn't clobber our explicit scroll target.
  if (_previewScrollRestoreRaf) {
    cancelAnimationFrame(_previewScrollRestoreRaf);
    _previewScrollRestoreRaf = null;
  }

  // smooth scroll, target near top of preview pane
  target.scrollIntoView({ behavior: 'smooth', block: 'start' });

  // brief flash so user sees which block was hit (skip for chapter since the page is huge)
  if (sel.kind !== 'chapter') {
    target.classList.remove('b-anchor-flash');
    void target.offsetWidth;  // force reflow to restart animation
    target.classList.add('b-anchor-flash');
  }
}

function isElementInPane(el, pane) {
  const eRect = el.getBoundingClientRect();
  const pRect = pane.getBoundingClientRect();
  // Top within the pane (with a small margin so we don't trigger on barely-visible)
  const margin = 24;  // px
  return eRect.top >= pRect.top + margin && eRect.bottom <= pRect.bottom;
}

function cssEscape(s) {
  if (window.CSS && CSS.escape) return CSS.escape(s);
  return String(s).replace(/[^a-zA-Z0-9_-]/g, ch => '\\' + ch);
}

/* ============================================================
   INLINE EDIT — click any text block in the preview to edit it
   directly. A floating toolbar (B / I / ⎵ / ＋↕ / ✓ / ✕) appears
   with markdown helpers. Save by clicking outside, pressing Esc,
   or clicking the ✓ button. Cancel with the ✕ button.
   ============================================================ */
let _inlineEdit = null;  // { block, element, prop, original }

function findBlockById(id) {
  for (const c of state.doc.chapters) {
    for (const s of c.sections) {
      const b = s.blocks.find(x => x.id === id);
      if (b) return { block: b, section: s, chapter: c };
    }
  }
  return null;
}

function getEditableProp(block) {
  // Map block type → which text property to edit
  if (block.content  !== undefined) return 'content';
  if (block.text     !== undefined) return 'text';
  if (block.question !== undefined) return 'question';
  return null;
}

/* ----- Live image resize in preview -----
   Drag the bottom-right corner handle to change b.width.
   The percentage is clamped to [25, 150] and rounded to integer. */
function findBlockRaw(id) {
  for (const ch of state.doc.chapters || []) {
    for (const s of ch.sections || []) {
      for (const b of (s.blocks || [])) if (b.id === id) return b;
    }
  }
  return null;
}

function initImageResize() {
  const root = document.getElementById('previewRoot');
  if (!root) return;

  let drag = null; // { blockId, startX, startWidth, startPct, wrap, img, tip, colW }

  function getTip() {
    let tip = document.getElementById('ptbResizeTip');
    if (!tip) {
      tip = document.createElement('div');
      tip.id = 'ptbResizeTip';
      tip.className = 'ptb-resize-tip';
      document.body.appendChild(tip);
    }
    return tip;
  }

  function onDown(e) {
    if (e.button !== 0) return;
    const handle = e.target.closest('.b-image-resize-handle');
    if (!handle) return;
    const wrap = handle.closest('.b-image');
    if (!wrap) return;
    const img = wrap.querySelector('img.b-image-img');
    if (!img) return;                            // placeholder, no real image
    const blockId = wrap.dataset.blockId;
    if (!blockId) return;

    e.preventDefault();
    e.stopPropagation();

    // Find the column (or page) the image lives in — that defines 100%
    const colEl = wrap.closest('.col-main, .col-side, .page');
    const colW  = colEl ? colEl.getBoundingClientRect().width
                        : wrap.parentElement.getBoundingClientRect().width;
    const rect  = img.getBoundingClientRect();
    drag = {
      blockId,
      startX: e.clientX,
      startWidth: rect.width,
      startPct: parseInt(wrap.dataset.curWidth, 10) || 100,
      wrap, img, colW,
      tip: getTip(),
    };
    wrap.classList.add('ptb-resizing');
    document.body.classList.add('ptb-resizing');

    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp, { once: true });
  }

  function onMove(e) {
    if (!drag) return;
    const dx = e.clientX - drag.startX;
    // new px width = start width + dx; convert to % of column
    let newPct = Math.round(((drag.startWidth + dx) / drag.colW) * 100);
    newPct = Math.max(25, Math.min(150, newPct));
    drag.img.style.maxWidth = newPct + '%';
    drag.wrap.dataset.curWidth = newPct;

    // Floating tip near cursor
    const t = drag.tip;
    t.textContent = newPct + '%';
    t.style.left = (e.clientX + 14) + 'px';
    t.style.top  = (e.clientY - 36) + 'px';
    t.style.opacity = '1';
  }

  function onUp() {
    if (!drag) return;
    const w = parseInt(drag.wrap.dataset.curWidth, 10) || 100;
    const block = findBlockRaw(drag.blockId);
    drag.wrap.classList.remove('ptb-resizing');
    document.body.classList.remove('ptb-resizing');
    drag.tip.style.opacity = '0';
    document.removeEventListener('mousemove', onMove);
    drag = null;

    if (block) {
      block.width = w;
      renderPreview();                          // re-render so the saved style
                                               // takes over and outline syncs
      // If user is currently editing this block, refresh editor so the
      // 125/100/75/50 buttons highlight the new value.
      const sel = state.selection;
      if (sel && sel.kind === 'block' && sel.id === block.id) renderEditor();
      showToast('圖片大小：' + w + '%', 'info');
    }
  }

  root.addEventListener('mousedown', onDown);
}

/* ----- Image align toolbar (left / center / right) -----
   Click one of the three buttons in the floating bar to set b.align.
   Updates the block, re-renders preview, and syncs the editor if open. */
function initImageAlign() {
  const root = document.getElementById('previewRoot');
  if (!root) return;
  const VALID = ['left', 'center', 'right'];
  root.addEventListener('click', (e) => {
    const btn = e.target.closest('.b-img-align');
    if (!btn) return;
    const bar = btn.closest('.b-image-align-bar');
    if (!bar) return;
    const blockId = bar.dataset.blockId;
    if (!blockId) return;
    const newAlign = btn.dataset.align;
    if (!VALID.includes(newAlign)) return;
    e.preventDefault();
    e.stopPropagation();

    const block = findBlockRaw(blockId);
    if (!block) return;
    block.align = newAlign;
    renderPreview();
    // Sync editor (so the editor's align buttons — if we add them — stay in sync)
    const sel = state.selection;
    if (sel && sel.kind === 'block' && sel.id === block.id) renderEditor();
    const label = newAlign === 'left' ? '靠左對齊' : newAlign === 'right' ? '靠右對齊' : '置中對齊';
    // Hint when width >= 100% so user understands the visual no-op
    const w = parseInt(block.width, 10) || 100;
    if (w >= 100) {
      showToast('圖片' + label + '（寬度 100% 已佔滿欄寬，建議先拖小一點再看差異）', 'info');
    } else {
      showToast('圖片' + label, 'info');
    }
  });
}

/* ----- Answer expand/collapse -----
   The .b-answer-circle button toggles b.expanded and re-renders. */
function initAnswerToggle() {
  const root = document.getElementById('previewRoot');
  if (!root) return;
  root.addEventListener('click', (e) => {
    const btn = e.target.closest('.b-answer-circle');
    if (!btn) return;
    const wrap = btn.closest('.b-answer');
    if (!wrap) return;
    const blockId = wrap.dataset.blockId;
    if (!blockId) return;
    const block = findBlockRaw(blockId);
    if (!block) return;
    block.expanded = (btn.dataset.act === 'expand');
    renderPreview();
    // Sync editor highlight if user is editing this block
    const sel = state.selection;
    if (sel && sel.kind === 'block' && sel.id === block.id) renderEditor();
  });
}

function initInlineEdit() {
  const root = document.getElementById('previewRoot');
  if (!root) return;
  root.addEventListener('click', (e) => {
    // While editing, only intercept clicks outside the editing element/toolbar
    if (_inlineEdit) {
      const toolbar = document.getElementById('inlineToolbar');
      const inEdit  = _inlineEdit.element && _inlineEdit.element.contains(e.target);
      const inTool  = toolbar && toolbar.contains(e.target);
      if (inEdit || inTool) return;
      // Click outside → save
      exitInlineEdit(true);
      e.stopPropagation();
      return;
    }
    // Find an editable block under the click
    const editableSelectors = [
      '.b-markdown',
      '.b-keyideas .ki-content',
      '.b-point .point-body',
      '.b-think .think-q',
      '.b-think .think-body',
      '.b-question .q-text',
    ];
    let editable = null;
    for (const sel of editableSelectors) {
      const found = e.target.closest(sel);
      if (found) { editable = found; break; }
    }
    if (!editable) return;
    const anchor = editable.closest('[data-block-id]');
    if (!anchor) return;
    const found = findBlockById(anchor.dataset.blockId);
    if (!found) return;
    const prop = getEditableProp(found.block);
    if (!prop) return;
    enterInlineEdit(found.block, found.section, prop, editable);
  });
}

function enterInlineEdit(block, section, prop, element) {
  if (_inlineEdit) exitInlineEdit(true);
  const original = block[prop] || '';
  _inlineEdit = { block, section, prop, element, original };

  // Switch the rendered element to raw-text editable mode
  element.textContent = original;
  element.classList.add('inline-editing');
  element.contentEditable = 'true';

  // Focus + cursor to end
  element.focus();
  placeCaretAtEnd(element);

  showInlineToolbar(element);
  // Reposition on scroll / resize
  window.addEventListener('scroll', updateToolbarPos, true);
  window.addEventListener('resize', updateToolbarPos);
}

function placeCaretAtEnd(el) {
  const range = document.createRange();
  range.selectNodeContents(el);
  range.collapse(false);
  const sel = window.getSelection();
  sel.removeAllRanges();
  sel.addRange(range);
}

function exitInlineEdit(save) {
  if (!_inlineEdit) return;
  const { block, element, prop } = _inlineEdit;
  window.removeEventListener('scroll', updateToolbarPos, true);
  window.removeEventListener('resize', updateToolbarPos);

  if (save) {
    const newText = element.textContent;
    if (newText !== block[prop]) {
      block[prop] = newText;
      showToast('已儲存', 'success');
    }
  } else {
    showToast('已取消', 'info');
  }

  element.classList.remove('inline-editing');
  element.contentEditable = 'false';
  _inlineEdit = null;
  hideInlineToolbar();
  renderPreview();
}

function showInlineToolbar(element) {
  let tb = document.getElementById('inlineToolbar');
  if (!tb) {
    tb = document.createElement('div');
    tb.id = 'inlineToolbar';
    tb.className = 'inline-toolbar';
    tb.innerHTML = `
      <button class="it-bold"   data-act="bold"     title="粗體 (Ctrl+B)">B</button>
      <button class="it-italic" data-act="italic"   title="斜體 (Ctrl+I)">I</button>
      <span class="it-sep"></span>
      <button class="it-space"  data-act="spaces"   title="插入 4 個全形空格">⎵</button>
      <button class="it-spacer" data-act="spacerow" title="插入空白行 (spacer block)">＋↕</button>
      <span class="it-sep"></span>
      <button class="it-save"   data-act="save"     title="儲存">✓</button>
      <button class="it-cancel" data-act="cancel"   title="取消 (Esc)">✕</button>
    `;
    document.body.appendChild(tb);
    tb.addEventListener('mousedown', e => e.preventDefault());  // keep focus
    tb.addEventListener('click', e => {
      const btn = e.target.closest('button');
      if (!btn) return;
      const act = btn.dataset.act;
      if      (act === 'bold')     wrapSelection('**', '**');
      else if (act === 'italic')   wrapSelection('*', '*');
      else if (act === 'spaces')   insertAtCursor('　　　　');
      else if (act === 'spacerow') insertSpacerAfter();
      else if (act === 'save')     exitInlineEdit(true);
      else if (act === 'cancel')   exitInlineEdit(false);
    });
  }
  updateToolbarPos();
  tb.style.display = 'flex';
}

function updateToolbarPos() {
  if (!_inlineEdit) return;
  const tb = document.getElementById('inlineToolbar');
  const el = _inlineEdit.element;
  if (!tb || !el) return;
  const r = el.getBoundingClientRect();
  const tbR = tb.getBoundingClientRect();
  let top = r.top - tbR.height - 8;
  if (top < 8) top = r.bottom + 8;
  let left = r.left + r.width / 2 - tbR.width / 2;
  left = Math.max(8, Math.min(window.innerWidth - tbR.width - 8, left));
  tb.style.top  = top  + 'px';
  tb.style.left = left + 'px';
}

function hideInlineToolbar() {
  const tb = document.getElementById('inlineToolbar');
  if (tb) tb.style.display = 'none';
}

function wrapSelection(before, after) {
  if (!_inlineEdit) return;
  const sel = window.getSelection();
  if (!sel.rangeCount || sel.isCollapsed) {
    // No selection — insert empty pair and place cursor between
    insertAtCursor(before + after);
    // Move cursor between
    const r = document.createRange();
    const tn = _inlineEdit.element.firstChild;
    if (tn) {
      r.setStart(tn, before.length);
      r.collapse(true);
      sel.removeAllRanges();
      sel.addRange(r);
    }
    return;
  }
  const range = sel.getRangeAt(0);
  if (!_inlineEdit.element.contains(range.commonAncestorContainer)) return;
  const text = range.toString();
  if (!text) return;
  range.deleteContents();
  const node = document.createTextNode(before + text + after);
  range.insertNode(node);
  // Move cursor to just after the closing marker
  range.setStart(node, before.length + text.length + after.length);
  range.collapse(true);
  sel.removeAllRanges();
  sel.addRange(range);
}

function insertAtCursor(text) {
  if (!_inlineEdit) return;
  const el = _inlineEdit.element;
  el.focus();
  const sel = window.getSelection();
  if (sel.rangeCount === 0 || !el.contains(sel.anchorNode)) {
    placeCaretAtEnd(el);
  }
  // execCommand preserves undo history & works with contenteditable
  try { document.execCommand('insertText', false, text); }
  catch (e) { insertAtCursorFallback(text); }
}

function insertAtCursorFallback(text) {
  const sel = window.getSelection();
  if (!sel.rangeCount) return;
  const range = sel.getRangeAt(0);
  range.deleteContents();
  range.insertNode(document.createTextNode(text));
  range.collapse(false);
  sel.removeAllRanges();
  sel.addRange(range);
}

function insertSpacerAfter() {
  if (!_inlineEdit) return;
  const { block, section } = _inlineEdit;
  const idx = section.blocks.findIndex(b => b.id === block.id);
  if (idx === -1) return;
  section.blocks.splice(idx + 1, 0, {
    id: cid(),
    type: 'spacer',
    height: 8,
    column: block.column || 'main',
  });
  exitInlineEdit(true);
  showToast('已插入空白行', 'success');
}

// Keyboard shortcuts while editing
document.addEventListener('keydown', e => {
  if (!_inlineEdit) return;
  if (e.key === 'Escape') {
    e.preventDefault();
    exitInlineEdit(false);
  } else if ((e.ctrlKey || e.metaKey) && !e.shiftKey) {
    if (e.key === 'b' || e.key === 'B') {
      e.preventDefault();
      wrapSelection('**', '**');
    } else if (e.key === 'i' || e.key === 'I') {
      e.preventDefault();
      wrapSelection('*', '*');
    } else if (e.key === 's' || e.key === 'S') {
      e.preventDefault();
      exitInlineEdit(true);
    }
  }
});

/* ----- Modals ----- */
/* ----- MC interactive: handle answer click ----- */
function mcAnswer(btnEl, blockId, pickedIdx) {
  const wrap = btnEl.closest('.b-mc');
  if (!wrap || wrap.classList.contains('mc-answered')) return;
  const correctIdx = parseInt(wrap.dataset.correct, 10);
  const isCorrect = pickedIdx === correctIdx;
  wrap.classList.add('mc-answered');

  // Mark the picked option
  btnEl.classList.add(isCorrect ? 'correct' : 'wrong');

  // If wrong, also mark the correct one
  if (!isCorrect) {
    wrap.querySelectorAll('.mc-opt').forEach(b => {
      if (parseInt(b.dataset.correct, 10) === 1) b.classList.add('correct');
    });
  }

  // Disable all options
  wrap.querySelectorAll('.mc-opt').forEach(b => { b.disabled = true; });

  // Show feedback
  const fb = wrap.querySelector('.mc-feedback');
  const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
  const correctOpt = wrap.querySelectorAll('.mc-opt')[correctIdx];
  const correctText = correctOpt ? correctOpt.querySelector('.mc-opt-text').innerText.trim() : '';
  if (isCorrect) {
    fb.className = 'mc-feedback mc-fb-correct';
    fb.innerHTML = `✓ 答對了！正確答案是 <strong>${letters[correctIdx]}</strong>。`;
  } else {
    fb.className = 'mc-feedback mc-fb-wrong';
    fb.innerHTML = `✗ 答錯了。正確答案是 <strong>${letters[correctIdx]}. ${escapeHtml(correctText)}</strong>。`;
  }

  // Show reset button
  const reset = wrap.querySelector('.mc-reset');
  if (reset) reset.style.display = 'inline-block';
}

function mcReset(btnEl) {
  const wrap = btnEl.closest('.b-mc');
  if (!wrap) return;
  wrap.classList.remove('mc-answered');
  wrap.querySelectorAll('.mc-opt').forEach(b => {
    b.classList.remove('correct', 'wrong');
    b.disabled = false;
  });
  const fb = wrap.querySelector('.mc-feedback');
  if (fb) { fb.className = 'mc-feedback'; fb.innerHTML = ''; }
  btnEl.style.display = 'none';
}

function openYouTube(videoId, title) {
  if (!videoId) { alert('尚未設定 Video ID'); return; }
  const root = document.getElementById('modalRoot');
  root.innerHTML = `
