/* ============================================================
   AI ASSISTANT — 自動分析 Markdown 並填入結構化區塊
   - 用戶自填 API Key (預設 MiniMax，可改任何 OpenAI 相容 API)
   - 貼上教材 Markdown / 純文字
   - AI 回傳 JSON 結構，自動拆成 block 預覽
   - 確認後插入目前小節
   ============================================================ */
const AI_STORAGE_KEYS = {
  key:      'ptb_ai_key',
  base:     'ptb_ai_base',
  model:    'ptb_ai_model',
  provider: 'ptb_ai_provider',  // 'minimax' | 'gemini'
};

/* Provider presets. Gemini uses the Generative Language API endpoint and can
   run with an empty key inside Google AI Studio / Gemini Sandbox (the Canvas
   environment auto-injects the key into ?key=). */
const AI_PROVIDERS = {
  minimax: {
    label:    'MiniMax（OpenAI 相容）',
    base:     'https://api.minimaxi.com/v1',
    model:    'MiniMax-Text-01',
    authMode: 'bearer',       // Authorization: Bearer <key>
    path:     '/text/chatcompletion_v2',
    bodyKind: 'openai',       // { model, messages: [{role, content}] }
  },
  gemini: {
    label:    'Gemini（Google AI，sandbox 可免費）',
    base:     'https://generativelanguage.googleapis.com/v1beta',
    model:    'gemini-2.0-flash',
    authMode: 'query',        // ?key=<key>  (sandbox 用空字串也行)
    path:     '',             // filled with /models/{model}:generateContent
    bodyKind: 'gemini',       // { contents: [{role, parts}], systemInstruction, generationConfig }
  },
};

let _aiLastResult = null;  // { sectionTitle, blocks: [...] }
let _aiDetectedSandbox = false;  // heuristic: hostname ends with .run.app / googleusercontent etc.

/* Pending rAF id for the preview scroll restore done inside renderPreview.
   If the caller follows up with scrollToSelection() we cancel this so the
   explicit scroll isn't clobbered by the restore. */
let _previewScrollRestoreRaf = null;

function detectSandbox() {
  try {
    const h = location.hostname || '';
    if (h === '' || h === 'localhost' || h === '127.0.0.1' || h === 'file') return false;
    return /\.(run\.app|googleusercontent\.com|appspot\.com|aistudio\.google\.com)$/i.test(h)
        || /\.usercontent\.google\.com$/i.test(h)
        || h.endsWith('.canvas.google')
        || h.endsWith('.gemini.google');
  } catch (e) { return false; }
}

function openAIPanel() {
  _aiDetectedSandbox = detectSandbox();
  const savedKey   = localStorage.getItem(AI_STORAGE_KEYS.key) || '';
  const savedBase  = localStorage.getItem(AI_STORAGE_KEYS.base);
  const savedModel = localStorage.getItem(AI_STORAGE_KEYS.model);
  let savedProvider = localStorage.getItem(AI_STORAGE_KEYS.provider) || 'minimax';
  // Auto-switch to Gemini if we detect running inside a Google sandbox
  if (_aiDetectedSandbox && !localStorage.getItem(AI_STORAGE_KEYS.provider)) {
    savedProvider = 'gemini';
  }
  const providerCfg = AI_PROVIDERS[savedProvider] || AI_PROVIDERS.minimax;
  const base        = savedBase  || providerCfg.base;
  const model       = savedModel || providerCfg.model;

  // Try to grab the current block's text as the initial content
  let initialContent = '';
  const sel = state.selection;
  if (sel && sel.kind === 'block') {
    const b = findBlock(sel.chapterId, sel.sectionId, sel.blockId);
    if (b) {
      if (b.content) initialContent = b.content;
      else if (b.text) initialContent = b.text;
      else if (b.question) initialContent = b.question;
    }
  }

  const root = document.getElementById('modalRoot');
  root.innerHTML = `
    <div class="modal-backdrop" onclick="if(event.target===this)closeAIPanel()">
      <button class="modal-close" onclick="closeAIPanel()" aria-label="關閉">✕</button>
      <div class="ai-modal" onclick="event.stopPropagation()">
        <div class="ai-header">
          <span style="font-size:22px;">🤖</span>
          <h2>AI 助手 — 自動填入結構化筆記</h2>
        </div>
        <div class="ai-body">
          <div class="ai-pane">
            <h3>① API 設定</h3>
            <div class="ai-settings">
              <div class="ai-row">
                <div>
                  <label>Provider（API 供應商）</label>
                  <select id="aiProvider" onchange="onProviderChange()">
                    ${Object.entries(AI_PROVIDERS).map(([k, p]) => `<option value="${k}" ${k === savedProvider ? 'selected' : ''}>${escapeHtml(p.label)}</option>`).join('')}
                  </select>
                </div>
                <div>
                  <label>API Key${savedProvider === 'gemini' ? '（sandbox 可留空）' : '（儲存在 localStorage）'}</label>
                  <input type="password" id="aiApiKey" value="${escapeAttr(savedKey)}" placeholder="${savedProvider === 'gemini' ? 'sandbox 留空即可' : 'eyJhbGciOi...'}" />
                </div>
              </div>
              <div class="ai-row">
                <div>
                  <label>Base URL</label>
                  <input type="text" id="aiBaseUrl" value="${escapeAttr(base)}" />
                </div>
                <div>
