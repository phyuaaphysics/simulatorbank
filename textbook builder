async function analyzeAIContent() {
  const input    = document.getElementById('aiInput').value.trim();
  const apiKey   = document.getElementById('aiApiKey').value.trim();
  const baseInp  = document.getElementById('aiBaseUrl').value.trim();
  const modelInp = document.getElementById('aiModel').value.trim();
  const provider = (document.getElementById('aiProvider') || {}).value || 'minimax';
  const cfg      = AI_PROVIDERS[provider] || AI_PROVIDERS.minimax;
  const base     = baseInp  || cfg.base;
  const model    = modelInp || cfg.model;

  // Gemini sandbox 允許空 key；其他 provider 必須有 key
  if (!apiKey && provider !== 'gemini') {
    setAIStatus('✗ 請先填入 API Key', 'error');
    return;
  }
  if (!input) {
    setAIStatus('✗ 請貼上教材內容', 'error');
    return;
  }

  // Save settings
  localStorage.setItem(AI_STORAGE_KEYS.key, apiKey);
  localStorage.setItem(AI_STORAGE_KEYS.base, base);
  localStorage.setItem(AI_STORAGE_KEYS.model, model);
  localStorage.setItem(AI_STORAGE_KEYS.provider, provider);

  setAIStatus('<span class="ai-spinner"></span>AI 正在分析內容…（' + escapeHtml(provider) + ' / ' + escapeHtml(model) + '）');

  const systemPrompt = `你是台灣中學物理科教材編輯，協助老師把零散的教材筆記整理成結構化區塊。
讀完使用者貼的內容後，輸出一個 JSON 物件（不要加任何 markdown 標記，純 JSON 字串），格式如下：
{
  "section_title": "（一句話總結此節主題，若使用者沒明確標題就自訂一個）",
  "blocks": [
    { "type": "objectives", "items": ["學習目標 1", "學習目標 2", ...] },
    { "type": "keyideas",   "content": "**Key points**：\\n- 要點 1\\n- 要點 2" },
    { "type": "formula",    "latex": "P = \\\\frac{F}{A}", "caption": "壓強公式" },
    { "type": "point",      "text": "記得帶單位" },
    { "type": "think",      "question": "為什麼要除以面積？", "hint": "想想接觸面變大會怎樣" },
    { "type": "caution",    "items": ["常見錯誤：忘記寫單位", "..."] },
    { "type": "question",   "text": "某人質量 60kg 站在地面上…？" }
  ]
}
規則：
1. 只輸 JSON，不要廢話。
2. 從原文抽取有教學價值的「學習目標、重點、公式、注意、思考、題目」；不要為了湊數而硬加。
3. 公式用 LaTeX 原始碼（display mode 用 $$...$$，inline 用 $...$）。
4. 題目、選項、解析都支援 markdown 跟 LaTeX。
5. 中文回應。
6. 若內容太短不足以生成區塊，回 {"section_title": "...", "blocks": []}。`;

  const userPrompt = `請分析以下教材內容，輸出結構化 JSON：\n\n---\n${input}\n---`;

  try {
    let resp, content;
    if (provider === 'gemini') {
      // ─── Gemini Generative Language API ───
      // Endpoint: POST {base}/models/{model}:generateContent?key={key}
      // Body:    { contents: [...], systemInstruction: {...}, generationConfig: {...} }
      // Response: data.candidates[0].content.parts[0].text
      const url = base.replace(/\/+$/, '') + '/models/' + encodeURIComponent(model) + ':generateContent'
                + (cfg.authMode === 'query' ? '?key=' + encodeURIComponent(apiKey) : '');
      const headers = { 'Content-Type': 'application/json' };
      if (cfg.authMode === 'bearer') headers['Authorization'] = 'Bearer ' + apiKey;
      const body = {
        contents: [
          { role: 'user', parts: [{ text: systemPrompt + '\n\n' + userPrompt }] }
        ],
        systemInstruction: { parts: [{ text: systemPrompt }] },
        generationConfig: { temperature: 0.3, responseMimeType: 'application/json' },
      };
      resp = await fetch(url, { method: 'POST', headers, body: JSON.stringify(body) });
      if (!resp.ok) {
        const errText = await resp.text();
        throw new Error(`HTTP ${resp.status}：${errText.slice(0, 250)}`);
      }
      const data = await resp.json();
      content = (data.candidates && data.candidates[0] && data.candidates[0].content && data.candidates[0].content.parts
                  && data.candidates[0].content.parts[0] && data.candidates[0].content.parts[0].text) || '';
    } else {
      // ─── OpenAI / MiniMax-compatible Chat Completions ───
      const url = base.replace(/\/+$/, '') + (cfg.path || '/text/chatcompletion_v2');
      const headers = { 'Content-Type': 'application/json' };
      if (cfg.authMode === 'bearer') headers['Authorization'] = 'Bearer ' + apiKey;
      else if (cfg.authMode === 'query') ;  // already on URL
      resp = await fetch(url, {
        method: 'POST', headers,
        body: JSON.stringify({
          model: model,
          messages: [
            { role: 'system', content: systemPrompt },
            { role: 'user',   content: userPrompt },
          ],
          temperature: 0.3,
        }),
      });
      if (!resp.ok) {
        const errText = await resp.text();
        throw new Error(`HTTP ${resp.status}：${errText.slice(0, 200)}`);
      }
      const data = await resp.json();
      // OpenAI 格式: { choices: [{ message: { content: "..." } }] }
      content = (data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) || '';
    }
    const parsed = parseAIJson(content);
    if (!parsed) {
      setAIStatus('✗ AI 回傳的內容無法解析為 JSON。請檢查模型名稱或 API 設定。<details style="margin-top:6px;color:#8e8e93;"><summary>看原始回應</summary><pre style="white-space:pre-wrap;font-size:11px;">' + escapeHtml(content.slice(0, 800)) + '</pre></details>', 'error');
      return;
    }
    _aiLastResult = parsed;
    renderAIResult(parsed);
    setAIStatus(`✓ 分析完成，建議 ${parsed.blocks.length} 個區塊（${escapeHtml(provider)}）`, 'success');
    updateAIInsertTarget();
  } catch (err) {
    setAIStatus('✗ 呼叫失敗：' + escapeHtml(err.message || String(err)), 'error');
  }
}

function parseAIJson(text) {
  if (!text) return null;
  // Strip code fences if present
  let t = text.trim();
  t = t.replace(/^```(?:json)?\s*/i, '').replace(/```\s*$/, '').trim();
  // Find first { and last }
  const start = t.indexOf('{');
  const end   = t.lastIndexOf('}');
  if (start === -1 || end === -1) return null;
  const slice = t.slice(start, end + 1);
  try { return JSON.parse(slice); } catch (e) { return null; }
}

function renderAIResult(parsed) {
  const wrap = document.getElementById('aiResult');
  if (!wrap) return;
  if (!parsed.blocks || parsed.blocks.length === 0) {
    wrap.innerHTML = '<div class="ai-result-empty">（AI 沒建議任何區塊）</div>';
    return;
  }
  const colorByType = {
    objectives: '#007aff', keyideas: '#1c8a4e', formula: '#af52de',
    point: '#ff2d6f',      think: '#ff9500',    caution: '#ff3b30',
    question: '#5856d6',
  };
  const html = [
    `<div style="font-size:12px; color:#6e6e73; margin-bottom:10px; padding-bottom:8px; border-bottom:1px dashed rgba(60,60,67,0.15);">
      <strong>章節標題建議：</strong>${escapeHtml(parsed.section_title || '（無）')}
    </div>`,
    ...parsed.blocks.map((b, i) => {
      const color = colorByType[b.type] || '#8e8e93';
      const label = b.type || 'unknown';
      let content = '';
      if (b.type === 'objectives') content = (b.items || []).map(x => '• ' + x).join('\n');
      else if (b.type === 'caution') content = (b.items || []).map(x => '⚠ ' + x).join('\n');
      else if (b.type === 'formula') content = (b.latex || '') + (b.caption ? '   [' + b.caption + ']' : '');
      else if (b.type === 'question') content = b.text || '';
      else if (b.type === 'think') content = (b.question || '') + (b.hint ? '\n💡 ' + b.hint : '');
      else if (b.text) content = b.text;
      else if (b.content) content = b.content;
      return `<div class="ai-block-preview">
        <span class="ai-block-type" style="background:${color};">${label}</span>
        <span class="ai-block-content">${escapeHtml(content).slice(0, 400)}</span>
      </div>`;
    })
  ].join('');
  wrap.innerHTML = html;
}

/* Normalize AI-returned block types to our canonical set.
   Different models (and different language styles) use slightly different
   type names — accept the common variants. */
const AI_TYPE_ALIASES = {
  // objectives
  'objectives': 'objectives', 'objective': 'objectives', 'goals': 'objectives',
  'learning_objectives': 'objectives', 'learning_objective': 'objectives',
  'aims': 'objectives', 'aim': 'objectives',
  // keyideas
  'keyideas': 'keyideas', 'key_ideas': 'keyideas', 'keyidea': 'keyideas',
  'key_idea': 'keyideas', 'key_points': 'keyideas', 'key_point': 'keyideas',
  'summary': 'keyideas', 'summaries': 'keyideas', 'takeaways': 'keyideas',
  'highlights': 'keyideas', 'concepts': 'keyideas', 'concept': 'keyideas',
  // formula
  'formula': 'formula', 'formulas': 'formula', 'equation': 'formula',
  'equations': 'formula', 'math': 'formula', 'maths': 'formula',
  // point
  'point': 'point', 'points': 'point', 'tip': 'point', 'tips': 'point',
  'key_point': 'point', 'key_points_inline': 'point', 'reminder': 'point',
  // think
  'think': 'think', 'thinking': 'think', 'thought': 'think', 'reflect': 'think',
  'reflection': 'think', 'discussion': 'think', 'ponder': 'think',
  // caution
  'caution': 'caution', 'cautions': 'caution', 'warning': 'caution',
  'warnings': 'caution', 'common_mistakes': 'caution', 'common_mistake': 'caution',
  'pitfall': 'caution', 'pitfalls': 'caution', 'mistake': 'caution',
  'mistakes': 'caution', 'gotcha': 'caution', 'gotchas': 'caution',
  // question
  'question': 'question', 'questions': 'question', 'exercise': 'question',
  'exercises': 'question', 'problem': 'question', 'problems': 'question',
  'quiz': 'question', 'task': 'question', 'practice': 'question',
};

function normalizeAIType(rawType) {
  if (!rawType) return null;
  const key = String(rawType).toLowerCase().trim().replace(/[\s-]+/g, '_');
  return AI_TYPE_ALIASES[key] || null;
}

/* Fallback: try to find a section to insert into when the user has no
   section/block selected. */
function findFallbackSection() {
  if (!state.doc || !state.doc.chapters.length) return null;
  for (let ci = state.doc.chapters.length - 1; ci >= 0; ci--) {
    const c = state.doc.chapters[ci];
    if (c.sections && c.sections.length) {
      const s = c.sections[c.sections.length - 1];
      return { chapter: c, section: s };
    }
  }
  return null;
}

function insertAIBlocks() {
  if (!_aiLastResult) {
    showAIToast('✗ 沒有可插入的結果', 'error');
    return;
  }

  // Resolve target section
  let c, s, sel = state.selection;
  if (sel && (sel.kind === 'section' || sel.kind === 'block')) {
    c = state.doc.chapters.find(x => x.id === sel.chapterId);
    s = c && c.sections.find(x => x.id === sel.sectionId);
  }
  if (!s) {
    // Fallback: use last section of the last chapter
    const fb = findFallbackSection();
    if (fb) {
      c = fb.chapter; s = fb.section;
      console.log('[AI] 沒選小節，自動用最後一個：', c.title, '／', s.title);
    }
  }
  if (!s) {
    setAIStatus('✗ 文件裡還沒有任何小節。請先建立章節 / 小節。', 'error');
    showToast('文件裡還沒有任何小節，無法插入', 'error');
    return;
  }

  // Optionally update section title (only if user hasn't customized it much)
  if (_aiLastResult.section_title && (!s.title || s.title.length < 3)) {
    s.title = _aiLastResult.section_title;
  }

  // Convert AI blocks → real blocks, with type alias tolerance
  const skipped = [];
  let added = 0;
  for (const ai of (_aiLastResult.blocks || [])) {
    const norm = normalizeAIType(ai.type);
    if (!norm) {
      skipped.push(ai.type || '(無 type)');
      continue;
    }
    const b = aiToBlock({ ...ai, type: norm });
    if (b) { s.blocks.push(b); added++; }
    else skipped.push(ai.type);
  }

  if (added === 0) {
    setAIStatus('✗ 沒有任何區塊被加入。AI 回傳的 ' + (_aiLastResult.blocks || []).length + ' 個區塊 type 都無法辨識（原始 type：' + skipped.join(', ') + '）。', 'error');
    showToast('沒有區塊被加入：AI 回傳的 type 都無法辨識', 'error');
    return;  // Keep modal open so the user can see the error
  }

  const target = (c.number || '') + ' ' + (c.title || '') + ' ／ ' + (s.number || '') + ' ' + (s.title || '未命名');
  console.log('[AI] inserted', added, 'blocks into', target, '— skipped:', skipped);

  // Show success in modal, then close + render + scroll
  setAIStatus('✓ 已插入 ' + added + ' 個區塊，正在關閉…', 'success');
  setTimeout(() => {
    closeAIPanel();
    state.selection = { kind: 'section', chapterId: c.id, sectionId: s.id };
    renderAll();
    // Cancel the scroll-restore that renderPreview scheduled — we want to
    // jump to the new blocks, not restore the user's previous scroll.
    if (_previewScrollRestoreRaf) { cancelAnimationFrame(_previewScrollRestoreRaf); _previewScrollRestoreRaf = null; }
    setTimeout(() => scrollToSelection(true), 50);  // small delay for layout
  }, 350);
  showToast('✓ AI 已加入 ' + added + ' 個區塊到「' + (s.title || '未命名') + '」', 'success');
}

/* Small toast shown in the AI modal itself (so the user sees it before closeAIPanel) */
function showAIToast(msg, kind) {
  const el = document.getElementById('aiStatus');
  if (el) {
    el.className = 'ai-status' + (kind ? ' ' + kind : '');
    el.innerHTML = msg;
  }
  // Also show a floating toast outside the modal so the user sees it after close
  if (typeof showToast === 'function') {
    showToast(msg.replace(/<[^>]+>/g, ''), kind || 'info');
  }
}

function aiToBlock(ai) {
  const id = cid();
  switch (ai.type) {
    case 'objectives': {
      const items = (ai.items || []).map(x => String(x).trim()).filter(Boolean);
      if (items.length === 0) return null;
      return { id, type: 'objectives', items, column: 'main' };
    }
    case 'keyideas': {
      const c = String(ai.content || '').trim();
      if (!c) return null;
      return { id, type: 'keyideas', content: c, column: 'main' };
    }
    case 'formula': {
      const latex = String(ai.latex || '').trim();
      if (!latex) return null;
      return { id, type: 'formula', latex, caption: String(ai.caption || ''), label: 0, numbered: true, column: 'main' };
    }
    case 'point': {
      const t = String(ai.text || '').trim();
      if (!t) return null;
      return { id, type: 'point', text: t, column: 'side' };
    }
    case 'think': {
      const q = String(ai.question || '').trim();
      if (!q) return null;
      return { id, type: 'think', question: q, hint: String(ai.hint || ''), column: 'side' };
    }
    case 'caution': {
      const items = (ai.items || []).map(x => String(x).trim()).filter(Boolean);
      if (items.length === 0) return null;
      return { id, type: 'caution', items, column: 'side' };
    }
    case 'question': {
      const t = String(ai.text || '').trim();
      if (!t) return null;
      return { id, type: 'question', text: t, num: 0, column: 'side' };
    }
  }
  return null;
}

document.addEventListener('keydown', e => {
