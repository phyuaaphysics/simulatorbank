body.ptb-spacing-wide .b-formula .formula-caption,
body.ptb-spacing-wide .b-point .point-text,
body.ptb-spacing-wide .b-think .think-q,
body.ptb-spacing-wide .b-think .think-body,
body.ptb-spacing-wide .b-think .think-hint,
body.ptb-spacing-wide .b-caution .caution-text,
body.ptb-spacing-wide .b-keyideas,
