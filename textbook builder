});

/* ----- Zoom ----- */
function setZoom(z) {
  state.zoom = Math.max(0.3, Math.min(1.5, z));
  document.getElementById('zoomLabel').textContent = Math.round(state.zoom * 100) + '%';
  document.querySelectorAll('.page-wrap').forEach(w => {
    w.style.width = (PAGE_W_MM * state.zoom) + 'mm';
    w.style.height = (PAGE_H_MM * state.zoom) + 'mm';
  });
  document.querySelectorAll('.page').forEach(p => {
    p.style.transform = `scale(${state.zoom})`;
  });
}
function fitZoom() {
  const pane = document.querySelector('.preview-scroll');
  const availW = pane.clientWidth - 40;
  const wPx = PAGE_W_MM * MM_TO_PX;
  const z = Math.min(1, availW / wPx);
  setZoom(z);
}

/* ----- Utils ----- */
function escapeHtml(s) {
  if (s == null) return '';
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function escapeAttr(s) { return escapeHtml(s); }

/* ----- Resize Handle ----- */
function initResizeHandle() {
  const handle = document.getElementById('previewResizeHandle');
  const previewPane = document.querySelector('.preview-pane');
  if (!handle || !previewPane) return;

  // Restore saved width
  try {
    const saved = localStorage.getItem('ptb_preview_width');
    if (saved) {
      const w = parseInt(saved, 10);
      const min = 280, max = window.innerWidth - 400;
      if (w >= min && w <= max) {
        previewPane.style.width = w + 'px';
      }
    }
  } catch (e) {}

  let isDragging = false;
  let startX = 0;
  let startWidth = 0;

  handle.addEventListener('mousedown', e => {
    isDragging = true;
    startX = e.clientX;
    startWidth = previewPane.getBoundingClientRect().width;
    handle.classList.add('dragging');
    document.body.classList.add('resizing');
    e.preventDefault();
  });

  document.addEventListener('mousemove', e => {
    if (!isDragging) return;
    const dx = e.clientX - startX; // positive = moved right
    const min = 280;
    const max = Math.max(min + 100, window.innerWidth - 400);
    const newWidth = Math.max(min, Math.min(max, startWidth - dx));
    previewPane.style.width = newWidth + 'px';
  });

  document.addEventListener('mouseup', () => {
    if (!isDragging) return;
    isDragging = false;
    handle.classList.remove('dragging');
    document.body.classList.remove('resizing');
    try {
      localStorage.setItem('ptb_preview_width', String(Math.round(previewPane.getBoundingClientRect().width)));
    } catch (e) {}
  });
}

/* ----- ImgBB Upload ----- */
function fileToBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = () => reject(new Error('檔案讀取失敗'));
    reader.readAsDataURL(file);
  });
}

async function uploadToImgbb(file) {
  if (!IMGBB_API_KEY) throw new Error('未設定 ImgBB API key');
  if (file.size > 32 * 1024 * 1024) throw new Error('檔案太大（上限 32MB）');

  const dataUrl = await fileToBase64(file);
  const base64 = dataUrl.split(',')[1];

  const form = new FormData();
  form.append('key', IMGBB_API_KEY);
  form.append('image', base64);

  const res = await fetch('https://api.imgbb.com/1/upload', {
    method: 'POST',
    body: form
  });
  const data = await res.json();
  if (!data.success) throw new Error(data.error?.message || '上傳失敗');
  return data.data.url;
}

/* ----- Init ----- */
function init() {
  loadFromStorage();
  document.getElementById('docTitle').value = state.doc.title || '';
  document.getElementById('docTitle').oninput = e => { state.doc.title = e.target.value; renderEditor(); };

  // ----- Print mode -----
  // Strategy: rely on CSS @media print rules (browser-standard) for hiding
  // shells during print. JS only does INLINE display:none on shells as a
  // safety net, then clears it via:
  //   1) `afterprint` event (if browser fires it)
  //   2) matchMedia('print').change fallback
  //   3) window.focus (dialog returns focus to page)
  //   4) visibilitychange (page becomes visible)
  //   5) Permanent setInterval(300ms) watchdog — the actual failsafe
  // We DELIBERATELY do NOT use `body.ptb-printing` class anymore, because
  // the class can get stuck on body and the entire CSS rule that hides
  // all shells (body.ptb-printing .toolbar, .outline, ...) can become a
  // permanent trap. Pure inline style is easier to clean.
  function inlineHide(sel) {
    document.querySelectorAll(sel).forEach(el => {
      if (!el.dataset.ptbPrevDisplay) el.dataset.ptbPrevDisplay = el.style.display || '';
      el.style.display = 'none';
    });
  }
  function inlineRestore() {
    document.querySelectorAll('[data-ptb-prev-display]').forEach(el => {
      el.style.display = el.dataset.ptbPrevDisplay || '';
      delete el.dataset.ptbPrevDisplay;
    });
  }
  function isPrinting() {
    return document.querySelector('[data-ptb-prev-display]') !== null;
  }
  function beforePrintHandler() {
    inlineHide('.toolbar');
    inlineHide('.outline');
    inlineHide('.editor');
    inlineHide('.preview-toolbar');
    inlineHide('.inline-toolbar');
    inlineHide('#inlineToolbar');
    inlineHide('#modalRoot');
    inlineHide('#ptbToastHost');
    inlineHide('.measure-host');
    inlineHide('.resize-handle');
    inlineHide('.oi-actions');
    inlineHide('.oi-insert');
    inlineHide('.modal-backdrop');
    inlineHide('.modal-close');
    // Close any open modals so they don't cover page after focus returns
    if (typeof closeAIPanel === 'function') {
      const modalRoot = document.getElementById('modalRoot');
      if (modalRoot && modalRoot.innerHTML.trim() !== '') closeAIPanel();
    }
  }
  function afterPrintHandler() {
    inlineRestore();
  }
  window.addEventListener('beforeprint', beforePrintHandler);
  window.addEventListener('afterprint', afterPrintHandler);
  if (window.matchMedia) {
    const mql = window.matchMedia('print');
    if (mql.addEventListener) {
      mql.addEventListener('change', e => {
        if (e.matches) beforePrintHandler(); else afterPrintHandler();
      });
    } else if (mql.addListener) {
      mql.addListener(e => {
        if (e.matches) beforePrintHandler(); else afterPrintHandler();
      });
    }
  }
  // Window focus returns when print dialog closes
  window.addEventListener('focus', () => {
    if (isPrinting()) setTimeout(afterPrintHandler, 100);
  });
  // Page becomes visible after print dialog
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && isPrinting()) afterPrintHandler();
  });
  // Any user interaction kicks us out (capture phase)
  function maybeClearPrint() { if (isPrinting()) afterPrintHandler(); }
  document.addEventListener('pointerdown', maybeClearPrint, true);
  document.addEventListener('keydown',     maybeClearPrint, true);
  document.addEventListener('scroll',      maybeClearPrint, true);

  // ----- Permanent watchdog (THE actual failsafe) -----
  // Started at init time so it ALWAYS exists, polling every 300ms.
  // The instant any inline display:none lingers, this clears it.
  // This is the only defence we can actually trust against Chrome's
  // "Save as PDF" never firing afterprint.
  setInterval(() => {
    if (isPrinting()) afterPrintHandler();
  }, 300);

  // ----- Emergency recovery: Escape key or ?reset=1 in URL -----
  // If the user is ever stuck in the "page is broken" state (regardless
  // of cause), they can press Escape or append ?reset=1 to the URL to
  // force-clear every inline display:none, body class, and data-attr.
  function emergencyReset() {
    console.warn('[ptb] Emergency UI reset triggered');
    // Strip ALL inline display values on all elements
    document.querySelectorAll('*').forEach(el => {
      if (el.style.display === 'none') el.style.display = '';
      if (el.dataset.ptbPrevDisplay) {
        el.style.display = el.dataset.ptbPrevDisplay || '';
        delete el.dataset.ptbPrevDisplay;
      }
    });
    document.body.classList.remove('ptb-printing', 'ptb-resizing', 'ptb-spacing-auto', 'ptb-spacing-wide', 'ptb-spacing-normal', 'ptb-lang-zh', 'ptb-lang-en');
    if (typeof renderAll === 'function') renderAll();
  }
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' || (e.ctrlKey && e.altKey && (e.key === 'r' || e.key === 'R'))) {
      emergencyReset();
    }
  });
  if (location.search.includes('reset=1')) {
    setTimeout(emergencyReset, 100);
  }
  // The big red reset button is always visible in the bottom-right corner.
  // Hover to reveal, click to wipe all inline styles and rebuild the UI.
  const resetBtn = document.getElementById('ptbEmergencyReset');
  if (resetBtn) {
    resetBtn.onmouseenter = () => { resetBtn.style.opacity = '1'; resetBtn.style.transform = 'scale(1.08)'; };
    resetBtn.onmouseleave = () => { resetBtn.style.opacity = '0.5'; resetBtn.style.transform = 'scale(1)'; };
    resetBtn.onclick = () => emergencyReset();
  }
  document.getElementById('addChapterBtn').onclick = addChapter;
  document.getElementById('newBtn').onclick = () => {
    if (confirm('建立新文件？這將清除目前所有資料（除非已匯出）')) {
      state.doc = createDefaultDoc();
      state.selection = { kind: 'doc' };
      document.getElementById('docTitle').value = state.doc.title;
      renderAll();
    }
  };
  document.getElementById('saveBtn').onclick = saveToStorage;
  document.getElementById('exportBtn').onclick = exportJSON;
  document.getElementById('pdfBtn').onclick = exportPDF;
  const aiBtn = document.getElementById('aiBtn');
  if (aiBtn) aiBtn.onclick = openAIPanel;
  document.getElementById('loadBtn').onclick = openImportDialog;
  document.getElementById('pImportBtn').onclick = openImportDialog;
  document.getElementById('pExportBtn').onclick = exportJSON;
  document.getElementById('pPdfBtn').onclick = exportPDF;
  document.getElementById('zoomIn').onclick = () => setZoom(state.zoom + 0.1);
  document.getElementById('zoomOut').onclick = () => setZoom(state.zoom - 0.1);
  document.getElementById('zoomFit').onclick = fitZoom;

  // ----- Letter-spacing mode toggle -----
  // Restore last-chosen mode from localStorage (default 'auto')
  try {
    const saved = localStorage.getItem('ptb_spacing_mode');
    if (saved && SPACING_MODES.includes(saved)) state.spacingMode = saved;
  } catch (e) {}
  document.getElementById('spacingModeBtn').onclick = cycleSpacingMode;

  initHalftoneBackground();
  initResizeHandle();
  initImageResize();
  initImageAlign();
  initAnswerToggle();
  initInlineEdit();
  renderAll();
  setTimeout(fitZoom, 60);
}

window.addEventListener('DOMContentLoaded', init);

/* ============================================================
   PWA — Service Worker registration + install prompt
   ============================================================ */
(function() {
  // Service worker only works on http(s) — skip on file:// (silent fail)
  if (!('serviceWorker' in navigator)) return;
  if (location.protocol !== 'http:' && location.protocol !== 'https:') return;

  window.addEventListener('load', () => {
    navigator.serviceWorker.register('sw.js')
      .then(reg => {
        // Check for updates periodically
        setInterval(() => reg.update().catch(() => {}), 60 * 60 * 1000);
        console.log('[PWA] Service worker registered:', reg.scope);
      })
      .catch(err => console.warn('[PWA] SW registration failed:', err));
  });

  // Capture beforeinstallprompt for a custom "Install" button
  let deferredInstallPrompt = null;
  window.addEventListener('beforeinstallprompt', e => {
    e.preventDefault();
    deferredInstallPrompt = e;
    window.dispatchEvent(new CustomEvent('pwa-installable', { detail: true }));
  });

  window.addEventListener('appinstalled', () => {
    deferredInstallPrompt = null;
    console.log('[PWA] App installed');
  });

  // Expose helper to trigger install from anywhere in the app
  window.pwaInstall = async function() {
    if (!deferredInstallPrompt) return false;
    deferredInstallPrompt.prompt();
    const choice = await deferredInstallPrompt.userChoice;
    return choice.outcome === 'accepted';
  };
  window.pwaIsInstallable = function() { return !!deferredInstallPrompt; };
})();
</script>
