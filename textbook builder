/* ----- Persistence ----- */
const STORAGE_KEY = 'ptb_doc_v1';

function loadFromStorage() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      const data = JSON.parse(raw);
      if (data && data.chapters) {
        state.doc = data;
      }
    }
  } catch (e) { console.warn('load failed', e); }
}

function saveToStorage() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state.doc));
    flashSaveStatus('已儲存');
  } catch (e) {
    flashSaveStatus('儲存失敗');
    console.error(e);
  }
}

function flashSaveStatus(msg) {
  const btn = document.getElementById('saveBtn');
  const orig = btn.textContent;
  btn.textContent = '✓ ' + msg;
  setTimeout(() => { btn.textContent = orig; }, 1200);
}

function exportJSON() {
  const data = JSON.stringify(state.doc, null, 2);
  const blob = new Blob([data], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = (state.doc.title || 'textbook') + '.json';
  a.click();
  setTimeout(() => URL.revokeObjectURL(url), 0);
}

function exportPDF() {
  // Use browser's native print → save as PDF
  // Each A4 page in preview maps to one printed page via @page CSS
  // User tip: in the print dialog, set destination = "Save as PDF"
  // and enable "Background graphics" to keep borders & callout boxes
  if (!sessionStorage.getItem('pdf-hint-shown')) {
    sessionStorage.setItem('pdf-hint-shown', '1');
    setTimeout(() => {
      alert('PDF 匯出小提醒：\n\n1. 目的地選「另存為 PDF」\n2. 邊界選「無」\n3. 勾選「背景圖形」才會印出 callout 框線與顏色\n\n（這個提示只顯示一次）');
    }, 100);
  }
  window.print();
}

function importJSON(file) {
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const data = JSON.parse(e.target.result);
      if (data && Array.isArray(data.chapters)) {
        state.doc = data;
        state.selection = { kind: 'doc' };
        document.getElementById('docTitle').value = data.title || '';
        renderAll();
        flashSaveStatus('已載入');
      } else {
        alert('JSON 結構不正確，缺少 chapters 陣列。');
      }
    } catch (err) { alert('JSON 解析失敗：' + err.message); }
  };
  reader.readAsText(file);
}

function openImportDialog() {
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = '.json,application/json';
  inp.onchange = e => { if (e.target.files && e.target.files[0]) importJSON(e.target.files[0]); };
  inp.click();
}

/* ----- Find helpers ----- */
function findChapter(id) { return state.doc.chapters.find(c => c.id === id); }
function findSection(chapterId, sectionId) {
  const c = findChapter(chapterId); if (!c) return null;
  return c.sections.find(s => s.id === sectionId);
}
function findBlock(chapterId, sectionId, blockId) {
  const s = findSection(chapterId, sectionId); if (!s) return null;
  return s.blocks.find(b => b.id === blockId);
}

/* ----- Mutations ----- */
function addChapter() {
  const c = { id: cid(), number: state.doc.chapters.length + 1,
              title: '新章節', subtitle: '', intro: '', sections: [] };
  state.doc.chapters.push(c);
  state.selection = { kind: 'chapter', chapterId: c.id };
  renderAll();
}
function addSection(chapterId) {
  const c = findChapter(chapterId); if (!c) return;
  const idx = c.sections.length + 1;
  const s = { id: cid(), number: `${c.number}-${idx}`, title: '新小節', blocks: [] };
  c.sections.push(s);
  // Auto-expand: new section is shown open so user can immediately add content
  if (state.outline && state.outline.expandedSections) state.outline.expandedSections.add(s.id);
  // Auto-expand: the parent chapter too (in case it was collapsed)
  if (state.outline && state.outline.expandedChapters) state.outline.expandedChapters.add(chapterId);
  state.selection = { kind: 'section', chapterId, sectionId: s.id };
  renderAll();
}

/* Insert a new section at the given index (0-based) inside a chapter.
   Used by the "+ between sections" buttons in the outline panel. */
function insertSection(chapterId, index) {
  const c = findChapter(chapterId); if (!c) return;
  // Clamp the index so out-of-range clicks don't throw
  const i = Math.max(0, Math.min(c.sections.length, index | 0));
  const s = { id: cid(), number: `${c.number}-${i + 1}`, title: '新小節', blocks: [] };
  c.sections.splice(i, 0, s);
  // Renumber subsequent sections so labels stay sequential
  c.sections.forEach((sec, n) => { sec.number = `${c.number}-${n + 1}`; });
  if (state.outline && state.outline.expandedSections) state.outline.expandedSections.add(s.id);
  if (state.outline && state.outline.expandedChapters) state.outline.expandedChapters.add(chapterId);
  state.selection = { kind: 'section', chapterId, sectionId: s.id };
  renderAll();
  showToast('已插入新小節於 ' + (i === 0 ? '最前' : '第 ' + (i + 1) + ' 個位置'), 'success');
}
function addBlock(chapterId, sectionId, type) {
  const s = findSection(chapterId, sectionId); if (!s) return;
  const b = createBlock(type);
  s.blocks.push(b);
  state.selection = { kind: 'block', chapterId, sectionId, blockId: b.id };
  renderAll();
}
function createBlock(type) {
  const id = cid();
  const col = (type === 'point' || type === 'think' || type === 'caution' || type === 'question') ? 'side' : 'main';
  switch (type) {
    case 'markdown':   return { id, type, content: '', column: 'main' };
    case 'image':      return { id, type, url: '', caption: '', width: 100, align: 'center', column: 'main' };
    case 'youtube':    return { id, type, videoId: '', caption: '', column: 'main' };
    case 'objectives': return { id, type, items: [''], column: 'main' };
    case 'keyideas':   return { id, type, content: '', column: 'main' };
    case 'answer':     return { id, type, content: '', label: '答案', expanded: false, column: 'main' };
    case 'formula':    return { id, type, latex: '', label: '', caption: '', numbered: true, column: 'main' };
    case 'point':      return { id, type, text: '', column: 'side' };
    case 'think':      return { id, type, question: '', hint: '', column: 'side' };
    case 'caution':    return { id, type, items: [''], column: 'side' };
    case 'question':   return { id, type, text: '', num: 0, column: 'side' };
    case 'answerlines': return { id, type, label: '', lines: 5, lineHeight: 9, column: 'main' };
    case 'pagebreak':   return { id, type, column: 'main' };
    case 'spacer':      return { id, type, height: 8, column: 'main' };
    case 'mc':          return { id, type, num: '', question: '', image: '', imageCaption: '', imageWidth: 100, options: ['', '', '', ''], answer: 0, explanation: '', column: 'main' };
    case 'table':       return { id, type, num: '', headers: ['欄 1', '欄 2', '欄 3'], rows: [['', '', ''], ['', '', ''], ['', '', '']], align: ['left','left','left'], colWidth: 0, caption: '', numbered: true, column: 'main' };
  }
  return null;
}
function deleteCurrent() {
  const sel = state.selection;
  if (sel.kind === 'chapter') {
    if (!confirm('刪除此章節及其所有內容？')) return;
    const idx = state.doc.chapters.findIndex(c => c.id === sel.chapterId);
    if (idx >= 0) state.doc.chapters.splice(idx, 1);
    state.selection = { kind: 'doc' };
  } else if (sel.kind === 'section') {
    if (!confirm('刪除此小節及其所有區塊？')) return;
    const c = findChapter(sel.chapterId);
    const idx = c ? c.sections.findIndex(s => s.id === sel.sectionId) : -1;
    if (idx >= 0) c.sections.splice(idx, 1);
    state.selection = { kind: 'chapter', chapterId: sel.chapterId };
  } else if (sel.kind === 'block') {
    const s = findSection(sel.chapterId, sel.sectionId);
    const idx = s ? s.blocks.findIndex(b => b.id === sel.blockId) : -1;
    if (idx >= 0) s.blocks.splice(idx, 1);
    state.selection = { kind: 'section', chapterId: sel.chapterId, sectionId: sel.sectionId };
  }
  renderAll();
}
function moveItem(direction) {
  const sel = state.selection;
  let arr, itemId;
  if (sel.kind === 'chapter') { arr = state.doc.chapters; itemId = sel.chapterId; }
  else if (sel.kind === 'section') { const c = findChapter(sel.chapterId); arr = c ? c.sections : []; itemId = sel.sectionId; }
  else if (sel.kind === 'block') { const s = findSection(sel.chapterId, sel.sectionId); arr = s ? s.blocks : []; itemId = sel.blockId; }
  if (!arr || !arr.length) return;
  const idx = arr.findIndex(x => x.id === itemId);
  const newIdx = idx + direction;
  if (newIdx < 0 || newIdx >= arr.length) return;
  [arr[idx], arr[newIdx]] = [arr[newIdx], arr[idx]];
  renderAll();
}

/* ----- Render: Outline ----- */
function renderOutline() {
  const root = document.getElementById('outlineList');
  root.innerHTML = '';
  if (state.doc.chapters.length === 0) {
    root.innerHTML = '<div class="empty"><h3>尚未建立章節</h3><p>點擊右上「＋ 章」開始</p></div>';
    return;
  }

  state.doc.chapters.forEach(c => {
    // Ensure new chapters are visible by default (existing collapsed state preserved)
    if (!state.outline.collapsedChapters) state.outline.collapsedChapters = new Set();
    if (!state.outline.expandedChapters) state.outline.expandedChapters = new Set();
    if (!state.outline.expandedSections) state.outline.expandedSections = new Set();

    const chapterExpanded = state.outline.expandedChapters.has(c.id);

    // Chapter row
    const item = document.createElement('div');
    const isChSel = state.selection.kind !== 'doc' && state.selection.chapterId === c.id;
    item.className = 'oi' + (isChSel ? ' selected' : '') + (chapterExpanded ? ' expanded' : '');
    item.innerHTML = `
      <div class="oi-row">
        <span class="oi-toggle" data-toggle="chapter:${c.id}" title="${chapterExpanded ? '收合' : '展開'}"></span>
        <div class="oi-icon chapter">${escapeHtml(String(c.number))}</div>
        <div class="oi-title">${escapeHtml(c.title || '未命名章')}</div>
        <div class="oi-actions">
          <button title="上移" data-act="up">▲</button>
          <button title="下移" data-act="down">▼</button>
          <button title="刪除" data-act="del">✕</button>
        </div>
      </div>
    `;
    item.onclick = e => {
      if (e.target.closest('.oi-toggle')) return;          // toggle handled separately
      if (e.target.closest('.oi-actions')) return;          // let action buttons work
      state.selection = { kind: 'chapter', chapterId: c.id };
      renderAll();
      scrollToSelection();
    };
    const btns = item.querySelectorAll('.oi-actions button');
    btns[0].onclick = e => { e.stopPropagation(); state.selection = { kind: 'chapter', chapterId: c.id }; moveItem(-1); };
    btns[1].onclick = e => { e.stopPropagation(); state.selection = { kind: 'chapter', chapterId: c.id }; moveItem(1); };
    btns[2].onclick = e => { e.stopPropagation(); state.selection = { kind: 'chapter', chapterId: c.id }; deleteCurrent(); };
    // Toggle handler
    item.querySelector('.oi-toggle').onclick = e => {
      e.stopPropagation();
      if (state.outline.expandedChapters.has(c.id)) state.outline.expandedChapters.delete(c.id);
      else state.outline.expandedChapters.add(c.id);
      renderOutline();
    };
    root.appendChild(item);

    // Sections — hidden when chapter is collapsed
    if (!chapterExpanded) return;

    c.sections.forEach((s, sIdx) => {
      // Insert-before button: between sections (not before the first one,
      // and not after the last — the trailing one is redundant since the
      // chapter's own 「＋ 新增小節」button already covers appending).
      if (sIdx > 0) {
        const ins = document.createElement('div');
        ins.className = 'oi-insert';
        ins.innerHTML = `<button title="在「${escapeHtml(s.title || '此節')}」之前插入新小節" aria-label="插入新小節">＋</button>`;
        ins.onclick = e => {
          e.stopPropagation();
          insertSection(c.id, sIdx);
        };
        root.appendChild(ins);
      }

      const sectionExpanded = state.outline.expandedSections.has(s.id);

      const sItem = document.createElement('div');
      const isSecSel = state.selection.kind === 'section' && state.selection.sectionId === s.id;
      sItem.className = 'oi oi-indent' + (isSecSel ? ' selected' : '') + (sectionExpanded ? ' expanded' : '');
      sItem.innerHTML = `
        <div class="oi-row">
          <span class="oi-toggle" data-toggle="section:${s.id}" title="${sectionExpanded ? '收合' : '展開'}"></span>
          <div class="oi-icon section">${escapeHtml(s.number || '§')}</div>
          <div class="oi-title">${escapeHtml(s.title || '未命名節')}</div>
          <div class="oi-actions">
            <button title="上移" data-act="up">▲</button>
            <button title="下移" data-act="down">▼</button>
            <button title="刪除" data-act="del">✕</button>
          </div>
        </div>
      `;
      sItem.onclick = e => {
        if (e.target.closest('.oi-toggle')) return;
        if (e.target.closest('.oi-actions')) return;
        state.selection = { kind: 'section', chapterId: c.id, sectionId: s.id };
        renderAll();
        scrollToSelection();
      };
      const sBtns = sItem.querySelectorAll('.oi-actions button');
      sBtns[0].onclick = e => { e.stopPropagation(); state.selection = { kind: 'section', chapterId: c.id, sectionId: s.id }; moveItem(-1); };
      sBtns[1].onclick = e => { e.stopPropagation(); state.selection = { kind: 'section', chapterId: c.id, sectionId: s.id }; moveItem(1); };
      sBtns[2].onclick = e => { e.stopPropagation(); state.selection = { kind: 'section', chapterId: c.id, sectionId: s.id }; deleteCurrent(); };
      sItem.querySelector('.oi-toggle').onclick = e => {
        e.stopPropagation();
        if (state.outline.expandedSections.has(s.id)) state.outline.expandedSections.delete(s.id);
        else state.outline.expandedSections.add(s.id);
        renderOutline();
      };
      root.appendChild(sItem);

      // Blocks — only shown when section is expanded
      if (sectionExpanded) {
        s.blocks.forEach(b => {
          const bItem = document.createElement('div');
          const isBSel = state.selection.kind === 'block' && state.selection.blockId === b.id;
          bItem.className = 'oi oi-indent deep' + (isBSel ? ' selected' : '');
          bItem.innerHTML = `
            <div class="oi-row" style="padding:5px 9px;">
              <div class="oi-icon block ${b.type}">${BLOCK_ICONS[b.type] || '·'}</div>
              <div class="oi-title" style="font-size:12.5px;">${escapeHtml(BLOCK_LABELS[b.type] || b.type)}</div>
              <div class="oi-actions">
                <button title="上移" data-act="up">▲</button>
                <button title="下移" data-act="down">▼</button>
                <button title="刪除" data-act="del">✕</button>
              </div>
            </div>
          `;
          bItem.onclick = e => {
            if (e.target.closest('.oi-actions')) return;
            state.selection = { kind: 'block', chapterId: c.id, sectionId: s.id, blockId: b.id };
            renderAll();
            scrollToSelection();
          };
          const bBtns = bItem.querySelectorAll('.oi-actions button');
          bBtns[0].onclick = e => { e.stopPropagation(); state.selection = { kind: 'block', chapterId: c.id, sectionId: s.id, blockId: b.id }; moveItem(-1); };
          bBtns[1].onclick = e => { e.stopPropagation(); state.selection = { kind: 'block', chapterId: c.id, sectionId: s.id, blockId: b.id }; moveItem(1); };
          bBtns[2].onclick = e => { e.stopPropagation(); state.selection = { kind: 'block', chapterId: c.id, sectionId: s.id, blockId: b.id }; deleteCurrent(); };
          root.appendChild(bItem);
        });

        // Add block hint (only when section is expanded, so the user must
        // expand to add — keeps the outline visually quiet)
        const addB = document.createElement('div');
        addB.className = 'oi-add deep';
        addB.textContent = '＋ 新增內容塊';
        addB.onclick = () => {
          state.selection = { kind: 'section', chapterId: c.id, sectionId: s.id };
          renderAll();
        };
        root.appendChild(addB);
      }
    });

    // Add section hint (always visible when chapter is expanded)
    const addS = document.createElement('div');
    addS.className = 'oi-add';
    addS.textContent = '＋ 新增小節';
    addS.onclick = () => addSection(c.id);
    root.appendChild(addS);
  });
}

