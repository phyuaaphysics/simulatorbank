/* ----- Letter-spacing mode (字距模式) -----
   'auto'   — detect CJK vs Latin in current doc; wide for zh, tight for en
   'wide'   — force 0.5pt CJK-wide letter-spacing on body text
   'normal' — force 0 letter-spacing (best for English) */
const SPACING_MODES = ['auto', 'wide', 'normal'];
const SPACING_LABELS = {
  auto:   '自動',
  wide:   '加寬（中）',
  normal: '正常（英）',
};

/* Pull plain text out of any block for language detection */
function extractBlockText(b) {
  if (!b) return '';
  switch (b.type) {
    case 'markdown':    return b.text || '';
    case 'point':       return b.text || b.title || '';
    case 'think':       return [b.q, b.body, b.hint].filter(Boolean).join(' ');
    case 'caution':     return b.text || '';
    case 'question':    return b.text || '';
    case 'answerlines': return b.label || '';
    case 'objectives':  return (b.items || []).join(' ');
    case 'keyideas':    return (b.items || []).join(' ');
    case 'formula':     return [b.latex, b.caption].filter(Boolean).join(' ');
    case 'mc':          return [b.question, b.imageCaption, (b.options || []).map(o => o.text || '').join(' '), b.explanation].filter(Boolean).join(' ');
    case 'table':       return [b.caption].concat(b.rows || []).flat().join(' ');
    case 'image':       return b.caption || '';
    case 'youtube':     return [b.title, b.caption].filter(Boolean).join(' ');
    case 'answer':      return b.label ? (b.label + ' ' + (b.content || '')) : (b.content || '');
    default:            return '';
  }
}

/* Walk every block in the doc and count CJK characters vs Latin letters.
   Returns 'zh' if CJK ≥ 30% of (CJK + Latin), else 'en'.
   If no text exists at all, defaults to 'zh' (matches the demo doc). */
function detectDocLanguage() {
  let zh = 0, en = 0;
  const re = /[\u3400-\u9fff\uf900-\ufaff]|[a-zA-Z]/g;
  const walk = blocks => {
    for (const b of blocks || []) {
      const t = extractBlockText(b);
      const m = t.match(re);
      if (!m) continue;
      for (const ch of m) {
        if (/[a-zA-Z]/.test(ch)) en++;
        else zh++;
      }
    }
  };
  for (const ch of state.doc.chapters || []) {
    walk(ch.blocks || []);                       // chapter-level free blocks
    for (const s of ch.sections || []) walk(s.blocks || []);
  }
  const total = zh + en;
  if (total === 0) return 'zh';                  // empty doc → assume zh
  return zh / total >= 0.30 ? 'zh' : 'en';
}

/* Apply the current spacingMode + detected language to <body> class. */
function applySpacingMode() {
  const body = document.body;
  // Strip previous spacing / lang classes
  body.classList.remove('ptb-spacing-auto', 'ptb-spacing-wide', 'ptb-spacing-normal');
  body.classList.remove('ptb-lang-zh', 'ptb-lang-en');

  const mode = state.spacingMode || 'auto';
  body.classList.add('ptb-spacing-' + mode);

  let effectiveLang = 'zh';
  if (mode === 'auto') {
    effectiveLang = detectDocLanguage();
    body.classList.add('ptb-lang-' + effectiveLang);
  }

  // Update toolbar button label + colour
  const btn = document.getElementById('spacingModeBtn');
  const label = document.getElementById('spacingModeLabel');
  if (btn) {
    btn.classList.remove('is-auto', 'is-wide', 'is-normal');
    btn.classList.add('is-' + mode);
    if (label) label.textContent = SPACING_LABELS[mode] || mode;
    let tip = '字距模式：';
    if (mode === 'auto')   tip += '自動 — 內容以中文為主時加寬、以英文為主時正常';
    if (mode === 'wide')   tip += '強制加寬（0.5pt，適合中文筆記）';
    if (mode === 'normal') tip += '強制正常（0，適合英文筆記）';
    if (mode === 'auto')   tip += '\n當前偵測：' + (effectiveLang === 'zh' ? '中文為主（已加寬）' : '英文為主（未加寬）');
    tip += '\n（點擊切換下一個模式）';
    btn.title = tip;
  }
}

/* Cycle to next spacing mode and persist to localStorage */
function cycleSpacingMode() {
  const i = SPACING_MODES.indexOf(state.spacingMode);
  const next = SPACING_MODES[(i + 1) % SPACING_MODES.length];
  state.spacingMode = next;
  try { localStorage.setItem('ptb_spacing_mode', next); } catch (e) {}
  applySpacingMode();
  showToast(
    '字距模式：' + (SPACING_LABELS[next] || next) +
    (next === 'auto'
      ? '（偵測為' + (detectDocLanguage() === 'zh' ? '中文' : '英文') + '為主）'
      : next === 'wide' ? '（已對所有正文加寬 0.5pt）' : '（已取消字距加寬）'),
    'info'
  );
}

