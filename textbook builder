/* Force tight letter-spacing for English */
body.ptb-spacing-normal .b-markdown,
body.ptb-spacing-normal .b-markdown p,
body.ptb-spacing-normal .b-markdown li,
body.ptb-spacing-normal .b-markdown table,
body.ptb-spacing-normal .b-table,
body.ptb-spacing-normal .b-table th,
body.ptb-spacing-normal .b-table td,
body.ptb-spacing-normal .b-table .tbl-caption,
body.ptb-spacing-normal .b-table .tbl-num,
body.ptb-spacing-normal .b-mc .mc-question,
body.ptb-spacing-normal .b-question .q-text,
body.ptb-spacing-normal .b-formula .formula-caption,
body.ptb-spacing-normal .b-point .point-text,
body.ptb-spacing-normal .b-think .think-q,
body.ptb-spacing-normal .b-think .think-body,
body.ptb-spacing-normal .b-think .think-hint,
body.ptb-spacing-normal .b-caution .caution-text,
body.ptb-spacing-normal .b-keyideas,
body.ptb-spacing-normal .b-objectives,
body.ptb-spacing-normal .b-answerlines .al-label,
body.ptb-spacing-normal .b-answerlines .al-line {
