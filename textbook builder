<script>
/* ============================================================
   Premium Textbook Builder — Core
   ============================================================ */

const MM_TO_PX = 96 / 25.4;        // ≈ 3.7795
const CONTENT_W_MM = 170;          // 210 - 20 - 20
const CONTENT_H_MM = 247;          // 297 - 25 - 25
const PAGE_W_MM = 210;
const PAGE_H_MM = 297;

// Configure marked
if (window.marked) {
  marked.setOptions({ breaks: true, gfm: true });
}

/* ----- LaTeX preprocessor -----
   Convert $...$ and $$...$$ in markdown to KaTeX-rendered HTML before
   handing off to marked. Code blocks (```...``` and `...`) are protected
   so '$' inside them isn't treated as math delimiters.
*/
function renderMarkdownWithLatex(md) {
  if (!md) return '';
  if (!window.katex) return md;

  // 1) Protect fenced code blocks
  const codeBlocks = [];
  let s = md.replace(/```[\s\S]*?```/g, (m) => {
    codeBlocks.push(m);
    return `\u0000CB${codeBlocks.length - 1}\u0000`;
  });
  // 2) Protect inline code
  const inlineCodes = [];
  s = s.replace(/`[^`\n]+`/g, (m) => {
    inlineCodes.push(m);
    return `\u0000IC${inlineCodes.length - 1}\u0000`;
  });

  // 3) Block equations: $$ ... $$  (multi-line)
  s = s.replace(/\$\$([\s\S]+?)\$\$/g, (_, tex) => {
    try {
      return `<div class="md-eq md-eq-block">${katex.renderToString(tex, { displayMode: true, throwOnError: false })}</div>`;
    } catch (e) {
      return `<div class="md-eq md-eq-block md-eq-error">[LaTeX 錯誤：${escapeHtml(e.message || String(e))}]</div>`;
    }
  });

  // 4) Inline equations: $ ... $  (single line, not $$)
  s = s.replace(/(^|[^$])\$([^\n$]+?)\$(?!\$)/g, (m, lead, tex) => {
    // skip if it looks like a markdown link [text](http...)  — no, those use ()
    // skip if it looks like a shell variable $(...) — unlikely in textbook content
    try {
      return `${lead}<span class="md-eq md-eq-inline">${katex.renderToString(tex, { displayMode: false, throwOnError: false })}</span>`;
    } catch (e) {
      return `${lead}<span class="md-eq md-eq-error">[LaTeX 錯誤：${escapeHtml(e.message || String(e))}]</span>`;
    }
  });

  // 5) Restore protected segments
  s = s.replace(/\u0000CB(\d+)\u0000/g, (_, i) => codeBlocks[parseInt(i, 10)]);
  s = s.replace(/\u0000IC(\d+)\u0000/g, (_, i) => inlineCodes[parseInt(i, 10)]);

  return s;
}

const BLOCK_ICONS = { markdown: 'M', image: '🖼', youtube: '▶', objectives: '◎', keyideas: '✦', formula: '∑', point: '!', think: '?', caution: '⚠', question: 'Q', answerlines: '⫶', pagebreak: '⏎', spacer: '↕', mc: '✓', table: '⊞', answer: '✓' };
const BLOCK_LABELS = { markdown: 'Markdown 文字', image: '圖片', youtube: 'YouTube 影片', objectives: '學習目標', keyideas: 'Key points', formula: '數學公式', point: '重點框 (Point)', think: '想一想 (Think)', caution: '注意 (Caution)', question: '題目 (Question)', answerlines: '作答橫線', pagebreak: '換頁 (Page Break)', spacer: '空白行 (Spacer)', mc: '選擇題 (MC)', table: '表格 (Table)', answer: '答案（Answer · 點擊展開）' };
